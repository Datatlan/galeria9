---
// Panel interno de ocupación — SOLO para el equipo (link con token).
// /panel?k=<token>            → todas las áreas
// /panel?k=<token>&area=punto-presencia | pop-up | tu-talento | invitado
// Lee unidades + rentas en vivo vía el Worker (?read=ocupacion, protegido).
import '../styles/global.css';
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <title>Ocupación — Galería 9</title>
</head>
<body>
  <main class="panel">
    <span class="eyebrow">Galería 9 · Panel interno</span>
    <h1 class="pn-title">Inventario y disponibilidad.</h1>
    <p class="pn-sub" id="pnSub">Cargando ocupación…</p>

    <div class="pn-bar" id="pnFilters" hidden></div>

    <div class="pn-meta" id="pnLegend" hidden>
      <span class="lg lg--oc"><i></i> Ocupado</span>
      <span class="lg lg--lb"><i></i> Disponible</span>
      <span class="lg lg--hoy"><i></i> Hoy</span>
    </div>

    <div class="pn-board" id="pnBoard" hidden><div class="pn-grid" id="pnGrid"></div></div>

    <div class="pn-error" id="pnError" hidden>
      <p class="lead">Acceso restringido.</p>
      <p class="muted">Este panel es del equipo de Galería 9. Revisa que tu link incluya la clave correcta.</p>
    </div>

    <div class="pn-pop-back" id="pnPopBack" hidden>
      <div class="pn-pop" id="pnPop"></div>
    </div>
  </main>

  <script>
    import { WORKER } from '../config.js';

    const qs = new URLSearchParams(location.search);
    const k = qs.get('k') || '';
    const esc = (s) => String(s ?? '').replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
    const slug = (s) => String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');

    const MESES = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    const now = new Date();
    const win0 = new Date(now.getFullYear(), now.getMonth(), 1); // ventana: 12 meses desde el actual
    const idxOf = (d) => (d.getFullYear() - win0.getFullYear()) * 12 + (d.getMonth() - win0.getMonth());

    const sub = document.getElementById('pnSub');
    const grid = document.getElementById('pnGrid');
    let data = null;

    function render(area) {
      areaActual = area || '';
      const espacioName = new Map(data.espacios.map((r) => [r.id, r.fields.Nombre]));
      const unidades = data.unidades.map((r) => ({
        id: r.id,
        n: r.fields.Nombre || '',
        tipo: r.fields.Tipo || '',
        espacio: (r.fields.Espacio || []).map((id) => espacioName.get(id)).filter(Boolean)[0] || 'Sin espacio',
      }));

      // Rentas por unidad (recortadas a la ventana de 12 meses)
      const porUnidad = new Map();
      for (const r of data.rentas) {
        const f = r.fields;
        if (!f.Fecha_Inicio) continue;
        const ini = new Date(f.Fecha_Inicio + 'T00:00');
        const fin = new Date((f.Fecha_Fin || f.Fecha_Inicio) + 'T00:00');
        let a = idxOf(ini), b = idxOf(fin);
        if (b < 0 || a > 11) continue;
        a = Math.max(0, a); b = Math.min(11, b);
        for (const uid of f.Unidades_Display || []) {
          if (!porUnidad.has(uid)) porUnidad.set(uid, []);
          porUnidad.get(uid).push({ nombre: f.Nombre || '', a, span: b - a + 1, ini: f.Fecha_Inicio, fin: f.Fecha_Fin || f.Fecha_Inicio, orden: (f.Orden || [])[0] || '' });
        }
      }

      // Filtro por área (espacio) + agrupar por espacio → tipo
      const visibles = unidades.filter((u) => !area || slug(u.espacio).includes(area));
      const grupos = new Map();
      for (const u of visibles.sort((x, y) => x.espacio.localeCompare(y.espacio) || x.tipo.localeCompare(y.tipo) || x.n.localeCompare(y.n, undefined, { numeric: true }))) {
        const g = u.tipo ? `${u.espacio} · ${u.tipo}` : u.espacio;
        if (!grupos.has(g)) grupos.set(g, []);
        grupos.get(g).push(u);
      }

      // Encabezado de meses
      let html = '<div class="pn-row pn-months"><span></span>' + Array.from({ length: 12 }, (_, i) => {
        const d = new Date(win0.getFullYear(), win0.getMonth() + i, 1);
        const y = (i === 0 || d.getMonth() === 0) ? ` <em>’${String(d.getFullYear()).slice(2)}</em>` : '';
        return `<span>${MESES[d.getMonth()]}${y}</span>`;
      }).join('') + '</div>';

      let libres = 0, ocupadas = 0;
      for (const [g, us] of grupos) {
        html += `<div class="pn-ghead">${esc(g)} <small>${us.length}</small></div>`;
        for (const u of us) {
          const rentas = porUnidad.get(u.id) || [];
          rentas.length ? ocupadas++ : libres++;
          html += `<div class="pn-row"><div class="pn-unit">${esc(u.n)}</div>`;
          for (let i = 0; i < 12; i++) html += `<div class="pn-cell" style="grid-column:${i + 2};grid-row:1"></div>`;
          html += `<div class="pn-hoy" style="grid-column:2"></div>`;
          for (const rta of rentas) {
            const marca = rta.nombre.replace(u.n, '').replace(/^\s*·\s*/, '').trim() || rta.nombre;
            const finTxt = new Date(rta.fin + 'T00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
            html += `<button type="button" class="pn-rent" style="grid-column:${rta.a + 2} / span ${rta.span}"
              data-orden="${esc(rta.orden)}" data-nombre="${esc(rta.nombre)}" data-unidad="${esc(u.n)}" data-ini="${esc(rta.ini)}" data-fin="${esc(rta.fin)}"
              title="${esc(rta.nombre)} — hasta ${finTxt}">${esc(marca)}<small>→ ${finTxt}</small></button>`;
          }
          html += '</div>';
        }
      }
      // Versión móvil: lista de estado por unidad (mismo popover al tocar).
      const fmtC = (d) => new Date(d + 'T00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
      let lista = '';
      for (const [g, us] of grupos) {
        lista += `<div class="pn-lg">${esc(g)}</div>`;
        for (const u of us) {
          const rentas = (porUnidad.get(u.id) || []).slice().sort((x, y) => x.a - y.a);
          if (!rentas.length) {
            lista += `<div class="pn-li"><span class="pn-li__u">${esc(u.n)}</span><span class="pn-chip pn-chip--free">Libre</span></div>`;
          } else {
            const r0 = rentas[0];
            const marca = r0.nombre.replace(u.n, '').replace(/^\s*·\s*/, '').trim() || r0.nombre;
            lista += `<button type="button" class="pn-li pn-li--btn"
              data-orden="${esc(r0.orden)}" data-nombre="${esc(r0.nombre)}" data-unidad="${esc(u.n)}" data-ini="${esc(r0.ini)}" data-fin="${esc(r0.fin)}">
              <span class="pn-li__u">${esc(u.n)}</span>
              <span class="pn-li__m">${esc(marca)}</span>
              <span class="pn-chip pn-chip--oc">hasta ${fmtC(r0.fin)}</span>
            </button>`;
          }
        }
      }

      const showCal = !area || area === 'eventos' || 'terraza roof'.includes(area);
      const unidadesHtml = area === 'eventos' ? '' :
        (html ? `<div class="pn-desk">${html}</div><div class="pn-mob">${lista}</div>` : '<p class="muted" style="padding:1rem 0">No hay unidades en esta área.</p>');
      grid.innerHTML = unidadesHtml + (showCal ? renderCal() : '');
      sub.textContent = `${visibles.length} unidades · ${ocupadas} ocupadas hoy o próximamente · ${(data.eventos || []).length} eventos en agenda`;
    }

    function renderFilters(area) {
      const box = document.getElementById('pnFilters');
      const espacioName = new Map(data.espacios.map((r) => [r.id, r.fields.Nombre]));
      const áreas = [...new Set(data.unidades.map((r) => (r.fields.Espacio || []).map((id) => espacioName.get(id)).filter(Boolean)[0]).filter(Boolean))].sort();
      box.innerHTML = [`<button class="pn-pill${!area ? ' is-on' : ''}" data-area="">Todos</button>`]
        .concat(áreas.map((a) => `<button class="pn-pill${area === slug(a) ? ' is-on' : ''}" data-area="${slug(a)}">${esc(a)}</button>`))
        .concat([`<button class="pn-pill${area === 'eventos' ? ' is-on' : ''}" data-area="eventos">Eventos</button>`])
        .join('');
      box.hidden = false;
      box.onclick = (e) => {
        const b = e.target.closest('.pn-pill');
        if (!b) return;
        const u = new URL(location.href);
        b.dataset.area ? u.searchParams.set('area', b.dataset.area) : u.searchParams.delete('area');
        history.replaceState(null, '', u);
        render(b.dataset.area || '');
        renderFilters(b.dataset.area || '');
      };
    }

    // Popover: click en una renta → orden, cliente y link directo a Airtable.
    const popBack = document.getElementById('pnPopBack');
    const pop = document.getElementById('pnPop');
    // ---- Calendario de eventos (Terraza/Roof) ----
    let calMes = new Date(now.getFullYear(), now.getMonth(), 1);
    let diaSel = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    let areaActual = '';

    const dkey = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const fmtH = (iso) => new Date(iso).toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' });

    function renderCal() {
      const espacioName = new Map(data.espacios.map((r) => [r.id, r.fields.Nombre]));
      const zonas = data.espacios.filter((r) => (r.fields.Tipo?.name ?? r.fields.Tipo) === 'Eventos').map((r) => r.fields.Nombre);

      // Índice: día → eventos (un evento multi-día cuenta en cada día que toca)
      const porDia = new Map();
      for (const r of data.eventos || []) {
        const f = r.fields;
        if (!f.Fecha_Inicio) continue;
        const espacios = (f.Espacio || []).map((id) => espacioName.get(id)).filter(Boolean);
        let d = new Date(f.Fecha_Inicio); d = new Date(d.getFullYear(), d.getMonth(), d.getDate());
        const fin = new Date(f.Fecha_Fin || f.Fecha_Inicio);
        for (let i = 0; i < 62 && d <= fin; i++, d = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1)) {
          const k = dkey(d);
          if (!porDia.has(k)) porDia.set(k, []);
          porDia.get(k).push({ f, espacios });
        }
      }

      // Rejilla del mes
      const y = calMes.getFullYear(), m = calMes.getMonth();
      const primero = new Date(y, m, 1);
      const diasMes = new Date(y, m + 1, 0).getDate();
      const titulo = calMes.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
      const hoyK = dkey(new Date());

      let celdas = '';
      for (let i = 0; i < primero.getDay(); i++) celdas += '<span></span>';
      for (let dia = 1; dia <= diasMes; dia++) {
        const k = dkey(new Date(y, m, dia));
        const n = (porDia.get(k) || []).length;
        const cls = ['pn-day', k === hoyK ? 'is-hoy' : '', k === diaSel ? 'is-sel' : '', n ? 'has-ev' : ''].join(' ');
        celdas += `<button type="button" class="${cls}" data-d="${k}">${dia}${n ? `<i>${'·'.repeat(Math.min(n, 3))}</i>` : ''}</button>`;
      }

      // Detalle del día: gráfica de horas (7am–10pm) con una fila por zona
      const H0 = 7, H1 = 22;
      const pos = (iso) => {
        const d = new Date(iso);
        const h = d.getHours() + d.getMinutes() / 60;
        return Math.max(0, Math.min(1, (h - H0) / (H1 - H0))) * 100;
      };
      const delDia = porDia.get(diaSel) || [];
      const fsel = new Date(diaSel + 'T00:00').toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

      const ticks = [7, 10, 13, 16, 19, 22].map((h) => {
        const lbl = h < 12 ? `${h}am` : h === 12 ? '12pm' : `${h - 12}pm`;
        return `<span style="left:${((h - H0) / (H1 - H0)) * 100}%">${lbl}</span>`;
      }).join('');

      let detalle = `<div class="pn-ghead">${fsel}</div>
        <div class="pn-dg"><span></span><div class="pn-dg__axis">${ticks}</div></div>`;
      for (const z of zonas.sort()) {
        const evz = delDia.filter((e) => e.espacios.includes(z));
        const bars = evz.map((e) => {
          const a = pos(e.f.Fecha_Inicio), b = Math.max(pos(e.f.Fecha_Fin || e.f.Fecha_Inicio), a + 4);
          const rango = `${fmtH(e.f.Fecha_Inicio)} – ${fmtH(e.f.Fecha_Fin || e.f.Fecha_Inicio)}`;
          return `<button type="button" class="pn-dg__bar"
            style="left:${a}%;width:${b - a}%"
            data-orden="${esc((e.f.Orden || [])[0] || '')}" data-nombre="${esc(e.f.Nombre || '')}" data-unidad="${esc(z)}"
            data-ini="${esc(e.f.Fecha_Inicio)}" data-fin="${esc(e.f.Fecha_Fin || e.f.Fecha_Inicio)}"
            title="${esc(e.f.Nombre)} · ${rango}">${rango}</button>`;
        }).join('');
        detalle += `<div class="pn-dg"><span class="pn-zona__n">${esc(z)}</span><div class="pn-dg__track">${bars}</div></div>`;
      }

      return `
      <div class="pn-cal">
        <div class="pn-ghead" style="border:0;padding-bottom:0">Agenda de eventos</div>
        <div class="pn-cal__head">
          <button type="button" class="pn-calnav" data-nav="-1">‹</button>
          <span class="pn-cal__t">${titulo}</span>
          <button type="button" class="pn-calnav" data-nav="1">›</button>
        </div>
        <div class="pn-cal__grid">
          ${['D', 'L', 'M', 'M', 'J', 'V', 'S'].map((d) => `<span class="pn-cal__wd">${d}</span>`).join('')}
          ${celdas}
        </div>
        <div class="pn-cal__detalle">${detalle}</div>
      </div>`;
    }

    // Acepta fecha sola ("2026-10-01") o datetime ISO (eventos)
    const fmt = (d) => {
      const dt = new Date(d.includes('T') ? d : d + 'T00:00');
      const base = dt.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
      return d.includes('T') ? `${base}, ${dt.toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' })}` : base;
    };

    document.getElementById('pnGrid').addEventListener('click', (e) => {
      const nav = e.target.closest('.pn-calnav');
      if (nav) {
        calMes = new Date(calMes.getFullYear(), calMes.getMonth() + Number(nav.dataset.nav), 1);
        render(areaActual);
        return;
      }
      const day = e.target.closest('.pn-day');
      if (day) {
        diaSel = day.dataset.d;
        render(areaActual);
        return;
      }
      const bar = e.target.closest('.pn-rent, .pn-li--btn, .pn-ev, .pn-dg__bar');
      if (!bar) return;
      const ordenById = new Map((data.ordenes || []).map((r) => [r.id, r.fields]));
      const clienteById = new Map((data.clientes || []).map((r) => [r.id, r.fields.Nombre]));
      const o = ordenById.get(bar.dataset.orden);
      const cliente = o ? ((o.Cliente || []).map((id) => clienteById.get(id)).filter(Boolean).join(', ') || o.Marca || '—') : '—';
      const est = o?.Estatus?.name || o?.Estatus || '';

      pop.innerHTML = `
        <button class="pn-pop__x" id="pnPopX" aria-label="Cerrar">×</button>
        <span class="eyebrow">${esc(bar.dataset.unidad)}</span>
        <h2 class="pn-pop__t">${esc(bar.dataset.nombre)}</h2>
        <div class="pn-pop__rows">
          <div><span>Cliente</span><b>${esc(cliente)}</b></div>
          <div><span>Orden</span><b>${esc(o?.OrderID || 'Sin orden ligada')}</b></div>
          ${est ? `<div><span>Estatus</span><b>${esc(est)}</b></div>` : ''}
          <div><span>Periodo</span><b>${fmt(bar.dataset.ini)} — ${fmt(bar.dataset.fin)}</b></div>
        </div>
        ${bar.dataset.orden ? `<a class="pn-pop__go" target="_blank" rel="noopener"
          href="https://airtable.com/appSkdHwrlulZ2iJc/tbl4RvFWf9fMzQUTz/${esc(bar.dataset.orden)}">Abrir orden en Airtable →</a>` : ''}`;
      popBack.hidden = false;
      document.getElementById('pnPopX').onclick = () => { popBack.hidden = true; };
    });
    popBack.addEventListener('click', (e) => { if (e.target === popBack) popBack.hidden = true; });

    (async () => {
      try {
        const res = await fetch(`${WORKER}?read=ocupacion&k=${encodeURIComponent(k)}`);
        if (!res.ok) throw new Error(String(res.status));
        data = await res.json();
        const area = slug(qs.get('area') || '') || '';
        document.getElementById('pnLegend').hidden = false;
        document.getElementById('pnBoard').hidden = false;
        renderFilters(area);
        render(area);
      } catch {
        sub.textContent = '';
        document.getElementById('pnError').hidden = false;
      }
    })();
  </script>

  <style is:global>
    body { padding: clamp(1.5rem, 4vw, 3.5rem); background: var(--paper); }
    .panel { max-width: 1100px; margin: 0 auto; }
    .pn-title { font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 400; margin-top: .8rem; letter-spacing: -.01em; }
    .pn-sub { margin-top: .6rem; color: var(--ink-70); font-weight: 300; font-size: .95rem; }

    .pn-bar { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.6rem; }
    .pn-pill {
      font-family: inherit; font-size: .8rem; padding: .55em 1.2em; border-radius: 100px;
      border: 1px solid var(--ink-12); background: var(--white); color: var(--ink-70); cursor: pointer;
      transition: background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease);
    }
    .pn-pill:hover { border-color: var(--ink); color: var(--ink); }
    .pn-pill.is-on { background: var(--ink); border-color: var(--ink); color: var(--paper); }

    .pn-meta { display: flex; align-items: center; gap: 1.6rem; margin-top: 1.2rem; }
    .lg { display: inline-flex; align-items: center; gap: .5em; font-size: .76rem; color: var(--ink-45); }
    .lg i { width: 14px; height: 8px; border-radius: 2px; display: inline-block; }
    .lg--oc i { background: var(--ink); }
    .lg--lb i { background: var(--white); box-shadow: inset 0 0 0 1px var(--ink-12); }
    .lg--hoy i { width: 2px; height: 12px; background: var(--gold); border-radius: 0; }

    .pn-board { margin-top: 1.2rem; background: var(--white); border-radius: var(--radius); box-shadow: 0 2px 14px -8px rgba(43,43,42,.25); padding: 1.2rem 1.4rem 1.6rem; overflow-x: auto; }
    .pn-grid { min-width: 900px; }

    .pn-row { display: grid; grid-template-columns: 130px repeat(12, 1fr); align-items: stretch; position: relative; }
    .pn-months { border-bottom: 1px solid var(--ink); padding-bottom: .5rem; }
    .pn-months span { font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-45); padding-left: .4rem; }
    .pn-months em { font-style: normal; color: var(--gold-ink); }

    .pn-ghead { padding: 1.4rem .2rem .45rem; font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-ink); font-weight: 600; border-bottom: 1px solid var(--ink-12); }
    .pn-ghead small { color: var(--ink-45); font-weight: 400; letter-spacing: .05em; margin-left: .5em; }

    .pn-unit { font-size: .8rem; color: var(--ink-70); padding: .55rem .4rem .55rem 0; display: flex; align-items: center; }
    .pn-cell { border-left: 1px solid rgba(43,43,42,.06); border-bottom: 1px solid rgba(43,43,42,.06); }
    .pn-row:not(.pn-months) { border-bottom: 1px solid rgba(43,43,42,.06); }

    .pn-rent {
      grid-row: 1; z-index: 2; align-self: center;
      background: var(--ink); color: var(--paper); border: 0; border-radius: 2px;
      font-family: inherit; font-size: .68rem; letter-spacing: .02em; padding: .32em .7em; margin: 3px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      cursor: pointer; text-align: left; transition: transform .2s var(--ease), box-shadow .2s var(--ease);
    }
    .pn-rent:hover { transform: translateY(-1px); box-shadow: 0 6px 14px -8px rgba(43,43,42,.5); }

    .pn-pop-back {
      position: fixed; inset: 0; z-index: 60; background: rgba(43,43,42,.35);
      display: grid; place-items: center; padding: 1.5rem;
    }
    .pn-pop {
      position: relative; background: var(--white); border-radius: var(--radius);
      box-shadow: 0 24px 60px -20px rgba(43,43,42,.5); padding: 1.8rem 2rem; width: min(420px, 100%);
    }
    .pn-pop__x {
      position: absolute; top: .8rem; right: 1rem; border: 0; background: none;
      font-size: 1.3rem; color: var(--ink-45); cursor: pointer; line-height: 1;
    }
    .pn-pop__x:hover { color: var(--ink); }
    .pn-pop__t { font-size: 1.15rem; font-weight: 500; margin-top: .7rem; }
    .pn-pop__rows { margin-top: 1.2rem; display: flex; flex-direction: column; gap: .55rem; }
    .pn-pop__rows div { display: flex; justify-content: space-between; gap: 1.5rem; font-size: .86rem; }
    .pn-pop__rows span { color: var(--ink-45); }
    .pn-pop__rows b { font-weight: 500; text-align: right; }
    .pn-pop__go {
      display: inline-block; margin-top: 1.4rem; font-size: .8rem; letter-spacing: .06em;
      color: var(--gold-ink); border-bottom: 1px solid var(--ink-12); padding-bottom: .3em;
      transition: border-color .3s var(--ease);
    }
    .pn-pop__go:hover { border-color: var(--ink); color: var(--ink); }
    .pn-rent small { color: var(--gold); margin-left: .5em; letter-spacing: .06em; }
    .pn-hoy { grid-row: 1; z-index: 3; width: 2px; background: var(--gold); justify-self: start; height: 100%; }

    .pn-error { margin-top: 2.5rem; }

    /* Calendario de eventos */
    .pn-cal { max-width: 720px; }
    .pn-cal__head { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 .8rem; }
    .pn-cal__t { font-size: .95rem; font-weight: 500; text-transform: capitalize; min-width: 150px; text-align: center; }
    .pn-calnav {
      width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--ink-12);
      background: var(--white); font-size: 1.1rem; color: var(--ink-70); cursor: pointer; line-height: 1;
      transition: border-color .25s var(--ease), color .25s var(--ease);
    }
    .pn-calnav:hover { border-color: var(--ink); color: var(--ink); }
    .pn-cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: .25rem; max-width: 380px; }
    .pn-cal__wd { font-size: .62rem; letter-spacing: .1em; color: var(--ink-45); text-align: center; padding: .3rem 0; }
    .pn-day {
      position: relative; aspect-ratio: 1; border: 0; border-radius: 50%;
      background: none; font-family: inherit; font-size: .8rem; color: var(--ink-70); cursor: pointer;
      display: grid; place-items: center; transition: background .2s var(--ease), color .2s var(--ease);
    }
    .pn-day:hover { background: var(--sand); }
    .pn-day.is-hoy { box-shadow: inset 0 0 0 1px var(--gold); }
    .pn-day.is-sel { background: var(--ink); color: var(--paper); }
    .pn-day i { position: absolute; bottom: 3px; left: 0; right: 0; font-style: normal; font-size: .8rem; line-height: .4; color: var(--gold-ink); letter-spacing: 1px; text-align: center; }
    .pn-day.is-sel i { color: var(--gold); }
    .pn-cal__detalle { margin-top: .6rem; }
    .pn-zona__n { font-size: .85rem; font-weight: 500; }

    /* Gráfica del día: horas de izquierda a derecha, una fila por zona */
    .pn-dg { display: grid; grid-template-columns: 80px 1fr; align-items: center; gap: .8rem; padding: .4rem 0; }
    .pn-dg__axis { position: relative; height: 16px; font-size: .6rem; letter-spacing: .06em; color: var(--ink-45); }
    .pn-dg__axis span { position: absolute; transform: translateX(-50%); }
    .pn-dg__track {
      position: relative; height: 36px; border-radius: 2px; background: var(--paper);
      box-shadow: inset 0 0 0 1px rgba(43,43,42,.08);
      background-image: repeating-linear-gradient(to right, rgba(43,43,42,.05) 0 1px, transparent 1px calc(100%/15));
    }
    .pn-dg__bar {
      position: absolute; top: 4px; bottom: 4px; border: 0; border-radius: 2px;
      background: var(--ink); color: var(--paper); font-family: inherit; font-size: .64rem; letter-spacing: .02em;
      padding: 0 .5em; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
      cursor: pointer; transition: transform .2s var(--ease), box-shadow .2s var(--ease);
    }
    .pn-dg__bar:hover { transform: translateY(-1px); box-shadow: 0 5px 12px -6px rgba(43,43,42,.5); }

    /* Agenda de eventos (Terraza/Roof) */
    .pn-ev {
      display: flex; align-items: center; gap: 1rem; width: 100%;
      padding: .7rem .2rem; border: 0; border-bottom: 1px solid rgba(43,43,42,.07);
      background: none; font-family: inherit; text-align: left; cursor: pointer;
    }
    .pn-ev:hover { background: var(--paper); }
    .pn-ev__d { font-size: .8rem; font-weight: 500; color: var(--ink); min-width: 92px; text-transform: capitalize; }
    .pn-ev__h { font-size: .78rem; color: var(--gold-ink); min-width: 150px; }
    .pn-ev__n { flex: 1; font-size: .82rem; color: var(--ink-70); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    @media (max-width: 720px) {
      .pn-ev { flex-wrap: wrap; gap: .2rem .8rem; }
      .pn-ev__n { flex-basis: 100%; }
    }

    /* Columna de unidades pegajosa (scroll horizontal en tablet) */
    .pn-unit, .pn-months span:first-child { position: sticky; left: 0; background: var(--white); z-index: 4; }

    /* Vista móvil: lista de estado por unidad */
    .pn-mob { display: none; }
    .pn-lg { padding: 1.3rem .2rem .45rem; font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-ink); font-weight: 600; border-bottom: 1px solid var(--ink-12); }
    .pn-li {
      display: flex; align-items: center; gap: .8rem; width: 100%;
      padding: .75rem .2rem; border: 0; border-bottom: 1px solid rgba(43,43,42,.07);
      background: none; font-family: inherit; text-align: left;
    }
    .pn-li--btn { cursor: pointer; }
    .pn-li--btn:active { background: var(--paper); }
    .pn-li__u { font-size: .85rem; color: var(--ink); min-width: 64px; font-weight: 500; }
    .pn-li__m { flex: 1; font-size: .85rem; color: var(--ink-70); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pn-chip { font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; padding: .4em .9em; border-radius: 100px; white-space: nowrap; }
    .pn-chip--free { background: var(--white); box-shadow: inset 0 0 0 1px var(--ink-12); color: var(--ink-45); }
    .pn-chip--oc { background: var(--ink); color: var(--paper); }

    @media (max-width: 720px) {
      body { padding: 1.2rem; }
      .pn-desk { display: none; }
      .pn-mob { display: block; }
      .pn-grid { min-width: 0; }
      .pn-board { padding: .4rem 1rem 1rem; }
      .pn-li:last-child { border-bottom: 0; }
    }
  </style>
</body>
</html>
