---
import Base from '../layouts/Base.astro';
---
<Base title="Onboarding — Galería 9" description="Prepara tu llegada a Galería 9: entrega tu material y confirma los detalles.">
  <section class="section">
    <div class="wrap wrap--narrow">
      <header class="mhead">
        <span class="eyebrow">Galería 9 · Onboarding</span>
        <h1 class="h2" style="margin-top:1rem">Prepara tu llegada.</h1>
        <p class="lead" id="obIntro">Cargando tu checklist…</p>
        <div class="ob-progress" id="obProgress" hidden>
          <div class="ob-progress__bar"><div class="ob-progress__fill" id="obFill"></div></div>
          <span class="ob-progress__label" id="obLabel"></span>
        </div>
      </header>

      <div class="ob-cita">
        <div class="ob-cita__head">
          <div>
            <strong>Agenda tu sesión de bienvenida</strong>
            <p class="muted" style="margin:.2rem 0 0">20 minutos para aclarar cualquier duda de tu proceso.</p>
          </div>
          <button type="button" class="btn btn--invert"
            data-cal-link="galeria-9-raembd/sesion-de-bienvenida"
            data-cal-namespace="bienvenida"
            data-cal-config='{"layout":"month_view","theme":"light"}'>Agendar</button>
        </div>
        <a href="https://cal.com/galeria-9-raembd/sesion-de-bienvenida" target="_blank" rel="noopener" class="ob-cita__alt">Si el calendario no abre, agenda en Cal.com →</a>
      </div>

      <div id="obList" class="ob-list"></div>

      <div class="ob-error" id="obError" hidden>
        <p class="lead">No encontramos tu checklist.</p>
        <p class="muted">Revisa que el link sea el que te enviamos, o escríbenos por WhatsApp y te lo reenviamos.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    // Cal.com inline embed — sesión de bienvenida (loader oficial)
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    // Modal al click en [data-cal-link] (namespace "bienvenida") — sin embed inline:
    // la lista vertical de horarios de 15 min hacía la tarjeta kilométrica.
    Cal("init", "bienvenida", { origin: "https://app.cal.com" });
    Cal.ns.bienvenida("ui", {
      theme: "light",
      cssVarsPerTheme: { light: { "cal-brand": "#2B2B2A" } },
      hideEventTypeDetails: false,
      layout: "month_view",
    });
  </script>

  <script>
    import { leerChecklist, guardarItem, subirArchivo } from '../config.js';

    const list = document.getElementById('obList');
    const intro = document.getElementById('obIntro');
    const errBox = document.getElementById('obError');
    const progress = document.getElementById('obProgress');
    const fill = document.getElementById('obFill');
    const label = document.getElementById('obLabel');

    const o = new URLSearchParams(location.search).get('o') || '';
    const REC = /^rec[A-Za-z0-9]{14}$/;

    const esc = (s) => String(s ?? '').replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
    const one = (v) => (Array.isArray(v) ? v[0] : v) ?? '';

    const PLACEHOLDER = {
      'Selección': 'Escribe aquí tu elección…',
      'Cita': 'Propón fecha y hora (ej. martes 26, 10:00 am)',
      'Pago': 'Referencia o fecha de tu transferencia',
      'Texto': 'Escribe aquí…',
    };

    let items = [];

    // Opciones (Tipo=Selección): cada línea es una pregunta; "Etiqueta :: a | b"
    // o solo "a | b" para un único grupo. La respuesta se guarda como texto.
    function parseOpts(txt) {
      return String(txt).split('\n').map((l) => l.trim()).filter(Boolean).map((line) => {
        const ix = line.indexOf('::');
        const label = ix >= 0 ? line.slice(0, ix).trim() : '';
        const opts = (ix >= 0 ? line.slice(ix + 2) : line).split('|').map((s) => s.trim()).filter(Boolean);
        return { label, opts };
      });
    }

    function prevChoices(respuesta, rows) {
      const lines = String(respuesta || '').split('\n').map((l) => l.trim());
      return rows.map((r) => {
        if (!r.label) return (respuesta || '').trim();
        const hit = lines.find((l) => l.startsWith(r.label + ':'));
        return hit ? hit.slice(r.label.length + 1).trim() : '';
      });
    }

    function renderSel(rows, respuesta, locked, itemId) {
      const prev = prevChoices(respuesta, rows);
      return `<div class="ob-opts">` + rows.map((r, ri) => `
        <div class="ob-optrow" data-label="${esc(r.label)}">
          ${r.label ? `<span class="ob-optrow__label">${esc(r.label)}</span>` : ''}
          <div class="ob-optrow__choices">
            ${r.opts.map((op) => `
              <label class="ob-opt">
                <input type="radio" name="og_${itemId}_${ri}" value="${esc(op)}"
                  ${prev[ri] === op ? 'checked' : ''} ${locked ? 'disabled' : ''} />
                <span>${esc(op)}</span>
              </label>`).join('')}
          </div>
        </div>`).join('') + `</div>`;
    }

    function renderFiles(it, locked) {
      const files = it.f.Archivos || [];
      const multiple = one(it.f.Tipo) === 'Archivo';
      return `
        <div class="ob-files">
          ${files.map((a) => `<span class="ob-file">📎 ${esc(a.filename)}</span>`).join('')}
          ${!locked ? `
            <label class="ob-upload">
              <input type="file" ${multiple ? 'multiple' : ''} hidden />
              <span>＋ ${files.length ? 'Agregar otro archivo' : 'Subir archivo'}</span>
            </label>` : ''}
        </div>
        <p class="ob-hint muted">Máx. 5 MB por archivo.</p>`;
    }

    const estOf = (it) => it.f.Estatus?.name ?? it.f.Estatus ?? 'Pendiente';

    function estadoChip(estatus) {
      const cls = estatus === 'Aprobado' ? 'is-ok' : estatus === 'Recibido' ? 'is-rx' : '';
      const txt = estatus === 'Aprobado' ? '✓ Aprobado' : estatus === 'Recibido' ? 'Recibido' : 'Pendiente';
      return `<span class="ob-chip ${cls}">${txt}</span>`;
    }

    // Agrupa items consecutivos que comparten Seccion.
    function buildBlocks() {
      const blocks = [];
      for (const it of items) {
        const sec = one(it.f.Seccion);
        const last = blocks[blocks.length - 1];
        if (sec && last && last.type === 'sec' && last.name === sec) last.items.push(it);
        else if (sec) blocks.push({ type: 'sec', name: sec, items: [it] });
        else blocks.push({ type: 'item', items: [it] });
      }
      return blocks;
    }

    // Card individual (igual que siempre)
    function renderItemCard(it, num) {
      const f = it.f;
      const tipo = one(f.Tipo);
      const estatus = estOf(it);
      const locked = estatus === 'Aprobado';
      const hasText = tipo !== 'Archivo';
      const hasFiles = tipo === 'Archivo' || tipo === 'Pago' || tipo === 'Texto';
      const opciones = one(f.Opciones);
      const selRows = tipo === 'Selección' && opciones ? parseOpts(opciones) : null;

      return `
      <article class="ob-card ${locked ? 'is-locked' : ''}" data-id="${it.id}">
        <div class="ob-card__head">
          <span class="ob-card__num">${num}</span>
          <h2 class="ob-card__title">${esc(f.Nombre)}</h2>
          ${estadoChip(estatus)}
        </div>
        ${one(f.Instrucciones) ? `<p class="ob-card__inst">${esc(one(f.Instrucciones))}</p>` : ''}
        ${selRows ? renderSel(selRows, f.Respuesta, locked, it.id) : hasText ? `
          <textarea class="ob-input" rows="3" placeholder="${esc(PLACEHOLDER[tipo] || 'Escribe aquí…')}"
            ${locked ? 'disabled' : ''}>${esc(f.Respuesta || '')}</textarea>` : ''}
        ${hasFiles ? renderFiles(it, locked) : ''}
        ${!locked ? `
          <div class="ob-actions">
            ${hasText ? `<button type="button" class="btn ob-save">${estatus === 'Pendiente' ? 'Enviar' : 'Actualizar'}</button>` : ''}
            <span class="ob-msg" hidden></span>
          </div>` : ''}
      </article>`;
    }

    // Card de SECCIÓN: varios requisitos juntos, un solo botón.
    function renderSecCard(block, num) {
      const allDone = block.items.every((it) => estOf(it) !== 'Pendiente');
      const allLocked = block.items.every((it) => estOf(it) === 'Aprobado');
      const chip = allLocked ? estadoChip('Aprobado') : allDone ? estadoChip('Recibido') : estadoChip('Pendiente');

      const rows = block.items.map((it) => {
        const f = it.f;
        const tipo = one(f.Tipo);
        const locked = estOf(it) === 'Aprobado';
        const check = estOf(it) !== 'Pendiente' ? ' <span class="ob-secrow__ok">✓</span>' : '';
        const opciones = one(f.Opciones);
        const selRows = tipo === 'Selección' && opciones ? parseOpts(opciones) : null;

        let control;
        if (selRows) control = renderSel(selRows, f.Respuesta, locked, it.id);
        else if (tipo === 'Archivo') control = renderFiles(it, locked);
        else control = `<input type="text" class="ob-secinput" value="${esc(f.Respuesta || '')}"
          placeholder="${esc(one(f.Instrucciones) || 'Escribe aquí…')}" ${locked ? 'disabled' : ''} />`;

        return `
        <div class="ob-secrow" data-id="${it.id}">
          <span class="ob-secrow__label">${esc(f.Nombre)}${check}</span>
          ${!selRows && one(f.Instrucciones) && tipo !== 'Texto' ? `<p class="ob-card__inst ob-card__inst--sec">${esc(one(f.Instrucciones))}</p>` : ''}
          ${selRows && one(f.Instrucciones) ? `<p class="ob-card__inst ob-card__inst--sec">${esc(one(f.Instrucciones))}</p>` : ''}
          ${control}
        </div>`;
      }).join('');

      return `
      <article class="ob-card ob-card--sec ${allLocked ? 'is-locked' : ''}">
        <div class="ob-card__head">
          <span class="ob-card__num">${num}</span>
          <h2 class="ob-card__title">${esc(block.name)}</h2>
          ${chip}
        </div>
        <div class="ob-secrows">${rows}</div>
        ${!allLocked ? `
          <div class="ob-actions">
            <button type="button" class="btn ob-save ob-save--sec">${allDone ? 'Actualizar' : 'Enviar'}</button>
            <span class="ob-msg" hidden></span>
          </div>` : ''}
      </article>`;
    }

    function render() {
      const done = items.filter((it) => estOf(it) !== 'Pendiente').length;
      progress.hidden = false;
      fill.style.width = items.length ? `${(done / items.length) * 100}%` : '0%';
      label.textContent = `${done} de ${items.length} entregados`;

      list.innerHTML = buildBlocks().map((b, i) =>
        b.type === 'sec' ? renderSecCard(b, i + 1) : renderItemCard(b.items[0], i + 1),
      ).join('');
    }

    async function refresh() {
      const recs = await leerChecklist(o);
      items = recs
        .map((r) => ({ id: r.id, f: r.fields }))
        .sort((a, b) => (one(a.f.Orden_Num) || 99) - (one(b.f.Orden_Num) || 99));
    }

    function msgOf(card, txt, ok = true) {
      const m = card.querySelector('.ob-msg');
      if (!m) return;
      m.textContent = txt;
      m.classList.toggle('is-err', !ok);
      m.hidden = false;
      setTimeout(() => { m.hidden = true; }, 3500);
    }

    // Lee la respuesta de un contenedor (fila de sección o card individual).
    function readValue(scope) {
      const optRows = [...scope.querySelectorAll('.ob-optrow')];
      if (optRows.length) {
        const partes = [];
        for (const rowEl of optRows) {
          const sel = rowEl.querySelector('input:checked');
          if (!sel) return { incomplete: true };
          partes.push(rowEl.dataset.label ? `${rowEl.dataset.label}: ${sel.value}` : sel.value);
        }
        return { value: partes.join('\n') };
      }
      const input = scope.querySelector('.ob-input, .ob-secinput');
      if (input) return { value: (input.value || '').trim() };
      return {};
    }

    // Guardar (card individual o sección)
    list.addEventListener('click', async (e) => {
      const btn = e.target.closest('.ob-save');
      if (!btn) return;
      const card = btn.closest('.ob-card');
      const label0 = btn.textContent;

      // --- Sección: guarda cada fila con contenido ---
      if (btn.classList.contains('ob-save--sec')) {
        const rows = [...card.querySelectorAll('.ob-secrow[data-id]')];
        const pend = [];
        for (const row of rows) {
          const { value, incomplete } = readValue(row);
          if (incomplete) { msgOf(card, 'Marca todas las opciones primero.', false); return; }
          if (value) pend.push({ id: row.dataset.id, value });
        }
        if (!pend.length) { msgOf(card, 'Llena al menos un campo.', false); return; }
        btn.disabled = true; btn.textContent = 'Enviando…';
        try {
          for (const p of pend) await guardarItem(p.id, p.value);
          await refresh(); render();
        } catch {
          btn.disabled = false; btn.textContent = label0;
          msgOf(card, 'No se pudo enviar. Intenta de nuevo.', false);
        }
        return;
      }

      // --- Card individual ---
      const { value, incomplete } = readValue(card);
      if (incomplete) { msgOf(card, 'Marca todas las opciones primero.', false); return; }
      if (!value) { msgOf(card, 'Escribe tu respuesta primero.', false); return; }
      btn.disabled = true; btn.textContent = 'Enviando…';
      try {
        await guardarItem(card.dataset.id, value);
        await refresh(); render();
      } catch {
        btn.disabled = false; btn.textContent = label0;
        msgOf(card, 'No se pudo enviar. Intenta de nuevo.', false);
      }
    });

    // Subir archivos (el data-id vive en la card o en la fila de sección)
    list.addEventListener('change', async (e) => {
      const input = e.target.closest('.ob-upload input[type=file]');
      if (!input || !input.files.length) return;
      const holder = input.closest('[data-id]');
      const card = input.closest('.ob-card');
      const lbl = input.closest('.ob-upload').querySelector('span');
      const files = [...input.files];
      lbl.textContent = 'Subiendo…';
      try {
        for (const file of files) await subirArchivo(holder.dataset.id, file);
        await refresh(); render();
      } catch (err) {
        lbl.textContent = '＋ Subir archivo';
        msgOf(card, err.message === 'MAX_5MB' ? 'Ese archivo pasa de 5 MB — comprímelo e intenta de nuevo.' : 'No se pudo subir. Intenta de nuevo.', false);
      }
    });

    // Arranque
    (async () => {
      if (!REC.test(o)) { intro.textContent = ''; errBox.hidden = false; return; }
      try {
        await refresh();
        if (!items.length) { intro.textContent = ''; errBox.hidden = false; return; }
        const marca = one(items[0].f.Marca);
        intro.textContent = marca
          ? `${marca}: entrega aquí tu material y confirma los detalles. Puedes volver a este link cuando quieras.`
          : 'Entrega aquí tu material y confirma los detalles. Puedes volver a este link cuando quieras.';
        render();
      } catch {
        intro.textContent = ''; errBox.hidden = false;
      }
    })();
  </script>

  <style is:global>
    .wrap--narrow { max-width: 760px; }

    .ob-progress { display: flex; align-items: center; gap: 1rem; margin-top: 1.6rem; }
    .ob-progress__bar { flex: 1; height: 4px; background: var(--ink-12); border-radius: 100px; overflow: hidden; }
    .ob-progress__fill { height: 100%; background: var(--gold); width: 0%; transition: width .6s var(--ease); }
    .ob-progress__label { font-size: .78rem; color: var(--ink-45); letter-spacing: .04em; white-space: nowrap; }

    .ob-cita {
      margin-top: 2rem; padding: 1.2rem 1.5rem;
      background: var(--white); border: 1px solid var(--ink-12); border-left: 3px solid var(--gold);
    }
    .ob-cita strong { font-size: .95rem; font-weight: 600; }
    .ob-cita__head { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
    .ob-cita__alt { display: inline-block; margin-top: .7rem; font-size: .72rem; color: var(--ink-45); text-decoration: none; }
    .ob-cita__alt:hover { color: var(--ink); }
    .ob-list { display: flex; flex-direction: column; gap: 1rem; margin-top: 2.4rem; }

    .ob-card {
      background: var(--white); border-radius: var(--radius); padding: 1.6rem 1.8rem;
      box-shadow: 0 2px 10px -6px rgba(43, 43, 42, .18), 0 1px 2px rgba(43, 43, 42, .04);
    }
    .ob-card.is-locked { opacity: .72; }

    .ob-card__head { display: flex; align-items: center; gap: .9rem; }
    .ob-card__num {
      width: 28px; height: 28px; flex: none; display: grid; place-items: center;
      border: 1px solid var(--ink-12); border-radius: 50%; font-size: .78rem; color: var(--ink-70);
    }
    .ob-card__title { font-size: 1.06rem; font-weight: 500; flex: 1; }

    .ob-chip {
      font-size: .64rem; letter-spacing: .12em; text-transform: uppercase;
      padding: .45em 1em; border-radius: 100px; background: var(--sand); color: var(--ink-70); white-space: nowrap;
    }
    .ob-chip.is-rx { background: var(--ink); color: var(--paper); }
    .ob-chip.is-ok { background: var(--gold); color: var(--ink); }

    .ob-card__inst { margin-top: .9rem; font-size: .9rem; color: var(--ink-70); white-space: pre-line; line-height: 1.55; }
    .ob-card__inst--sec { margin-top: .2rem; font-size: .82rem; }

    .ob-input {
      width: 100%; margin-top: 1rem; font-family: var(--sans); font-size: .98rem; color: var(--ink);
      padding: .9em 1em; border: 1px solid var(--ink-12); border-radius: var(--radius);
      background: var(--paper); resize: vertical; transition: border-color .3s var(--ease);
    }
    .ob-input:focus { outline: none; border-color: var(--ink); }
    .ob-input:disabled { opacity: .6; }

    /* Filas dentro de una sección */
    .ob-secrows { display: flex; flex-direction: column; gap: 1.1rem; margin-top: 1.3rem; }
    .ob-secrow__label { display: block; font-size: .82rem; letter-spacing: .04em; color: var(--ink-70); margin-bottom: .45rem; }
    .ob-secrow__ok { color: var(--gold-ink); }
    .ob-secinput {
      width: 100%; font-family: var(--sans); font-size: .95rem; color: var(--ink);
      padding: .75em 1em; border: 1px solid var(--ink-12); border-radius: var(--radius);
      background: var(--paper); transition: border-color .3s var(--ease);
    }
    .ob-secinput:focus { outline: none; border-color: var(--ink); }
    .ob-secinput:disabled { opacity: .6; }
    .ob-secrow .ob-opts, .ob-secrow .ob-files { margin-top: .2rem; }

    .ob-opts { margin-top: 1.1rem; display: flex; flex-direction: column; gap: .6rem; }
    .ob-optrow { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .ob-optrow__label { font-size: .88rem; color: var(--ink-70); min-width: 92px; }
    .ob-optrow__choices { display: flex; flex-wrap: wrap; gap: .5rem; }
    .ob-opt input { position: absolute; opacity: 0; pointer-events: none; }
    .ob-opt span {
      display: inline-block; font-size: .82rem; padding: .55em 1.1em; border-radius: 100px;
      border: 1px solid var(--ink-12); background: var(--white); color: var(--ink-70);
      cursor: pointer; transition: background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease);
    }
    .ob-opt:hover span { border-color: var(--ink); color: var(--ink); }
    .ob-opt input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--paper); }
    .ob-opt input:disabled + span { opacity: .6; cursor: not-allowed; }

    .ob-files { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .ob-file {
      font-size: .8rem; background: var(--paper); border: 1px solid var(--ink-12);
      padding: .5em .9em; border-radius: 100px; color: var(--ink-70); max-width: 100%;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .ob-upload { cursor: pointer; }
    .ob-upload span {
      display: inline-block; font-size: .8rem; padding: .5em .9em; border-radius: 100px;
      border: 1px dashed var(--ink-45); color: var(--ink-70); transition: border-color .3s var(--ease), color .3s var(--ease);
    }
    .ob-upload:hover span { border-color: var(--ink); color: var(--ink); }
    .ob-hint { font-size: .74rem; margin-top: .5rem; }

    .ob-actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.3rem; }
    .ob-msg { font-size: .82rem; color: var(--gold-ink); }
    .ob-msg.is-err { color: #b23a2f; }

    .ob-error { margin-top: 2.5rem; }

    @media (max-width: 520px) {
      .ob-card { padding: 1.2rem 1.1rem; }
    }
  </style>
</Base>
