---
import Base from '../layouts/Base.astro';

// Espacios rentables para EVENTOS (el showcase de marcas vive en "Para marcas")
const espacios = [
  { n: 'Terraza', d: 'Un patio verde en planta baja. Íntimo, cálido, ideal para reuniones y talleres.', cap: 'Hasta 40', foto: '/fotos/evento-terraza.jpg' },
  { n: 'Roof', d: 'Azotea con zona techada y cielo abierto. Para activaciones y celebraciones.', cap: 'Hasta 60', foto: '/fotos/evento-roof.jpg' },
];

const pilares = [
  { t: 'Bienestar', lema: 'Date una pausa', d: 'Entrena tu mente, cuerpo y emoción. Hábitos de belleza, relajación, reprogramación y respiración.' },
  { t: 'Market', lema: 'Invierte en ti', d: 'Market de marcas, eventos, activaciones y talleres.' },
  { t: 'Eventos', lema: 'Celébrate en gratitud', d: 'Encuentros y celebraciones diseñados a tu medida.' },
];

// Producto estrella del Market — card destacada de ancho completo.
// Por ahora todos los CTA de marcas llevan al form de contacto (pre-llenando
// el interés); los forms dedicados (/pop-up, /tu-talento, /tester-day) se
// irán habilitando poco a poco.
const puntoPresencia = {
  n: 'Punto Presencia',
  d: 'Tu marca encuentra un espacio físico. Membresía de 6 meses para compartir, validar y expandir la comunidad de tu marca.',
  meta: 'Mensual · 6 meses',
  foto: '/fotos/punto-presencia.jpg',
};

// Formatos de showcase para MARCAS
const marcas = [
  { n: 'Pop Up', d: 'Estrategia de 1 semana, movimiento digital y físico para la expansión de tu marca.', meta: 'Exhibición', foto: '/fotos/popup.jpg', href: '/pop-up' },
  { n: 'Tu Talento es un Arte', d: 'Expresa tu marca como arte, estrategia de visibilidad por 1 semana, conecta con nuevas comunidades.', meta: 'Semanal', foto: '/fotos/tu-talento.png' },
  { n: 'Tester Day', d: 'Regala pruebas o experiencias express y crea conexiones de valor con nuevas personas.', meta: 'Activación', foto: '/fotos/tester-day.jpg' },
  { n: 'Invitado Especial', d: 'Exhibe en el corazón de Galería 9 y expande tu visibilidad.', meta: '6 días', foto: '/fotos/invitado.jpg' },
];

// Cabinas — estructura pareja: nombre · lema · duración · contacto.
// Jar Almodovar sigue con placeholder (sin waLink = texto plano).
// Arigato 88 se quitó (ya no está en Galería 9).
const cabinas = [
  { n: 'Elsonidodefer', tipo: 'Studio', lema: 'Experiencias y programas de respiración y autoconocimiento', ic: 'self_improvement', wa: '33 3395 3558', waLink: '523333953558', ig: '@elsonidodefer', igLink: 'elsonidodefer', featured: true },
  { n: 'Reprogramación Mental', lema: 'Sesiones y programas 1:1 — entrena tu mente, educa tu palabra y transforma tu inconsciente', dur: '60 min', ic: 'psychology', wa: '33 1803 0563', waLink: '523318030563' },
  { n: 'Carolina', lema: 'El arte de volver a ti', desc: 'Masajes, talleres y experiencias de relajación', dur: '60 / 90 min', ic: 'volunteer_activism', wa: '33 3956 4990', waLink: '523339564990' },
  { n: 'Manoela Mena', lema: 'Diseña tu mirada — hidratación en piel y servicios de belleza', dur: '20 min', ic: 'face_retouching_natural', wa: '33 2312 4894', waLink: '523323124894', ig: '@bymanoelamena', igLink: 'bymanoelamena' },
  { n: 'Jar Almodovar', lema: 'Regeneración nutricional y hormonal', ic: 'nutrition', wa: '33 1000 0003', ig: '@jaralmodovar' },
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <span class="eyebrow reveal">Guadalajara · Market de Talentos</span>
        <h1 class="display reveal">Un punto de<br/>encuentro<br/>para marcas<br/>en expansión.</h1>
        <p class="lead hero__lead reveal">Galería 9 es un espacio de expansión en donde marcas y personas se expresan y comparten su esencia a través de la conexión con su talento.</p>
        <div class="hero__cta reveal">
          <a href="/cotiza" class="btn">Cotiza tu evento</a>
          <a href="/#experiencia" class="link-arrow">Conoce la casa →</a>
        </div>
      </div>
      <figure class="hero__photo reveal">
        <img src="/fotos/punto-presencia-2.jpg" alt="El Market de Galería 9" />
      </figure>
    </div>
  </section>

  <hr class="hairline" />

  <!-- EXPERIENCIA -->
  <section class="section" id="experiencia">
    <div class="wrap">
      <div class="two">
        <div class="reveal">
          <span class="eyebrow">Centro de negocios</span>
          <h2 class="h2" style="margin-top:1.2rem">Nuevo estilo de vida. Nueva transformación.</h2>
        </div>
        <p class="lead reveal">No somos una tienda ni un salón de eventos. Somos una casa curada donde el bienestar, las marcas locales y las celebraciones conviven — y se potencian entre sí. Además de los programas y estrategias que te apoyan en tu expansión, encuentras hábitos nuevos que sostienen toda tu transformación.</p>
      </div>

      <div class="exp-body">
        <figure class="exp-photo reveal">
          <img src="/fotos/cabina-arigato.png" alt="Cabina Arigato 88 en Galería 9" loading="lazy" />
          <figcaption>Cabina Arigato 88 · Masajes terapéuticos</figcaption>
        </figure>
        <div class="pilares">
          {pilares.map((p, i) => (
            <article class="pilar reveal" style={`transition-delay:${i * 90}ms`}>
              <span class="pilar__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{p.t} <span class="pilar__lema">{p.lema}</span></h3>
              <p class="muted">{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- EL LUGAR · interludio full-bleed -->
  <section class="lugar" id="lugar">
    <img src="/fotos/roof-2.jpg" alt="El roof de Galería 9" loading="lazy" />
    <div class="lugar__overlay reveal">
      <span class="eyebrow lugar__eyebrow">El lugar</span>
      <p class="lugar__addr">Bogotá 3025 · Providencia<br/>Guadalajara, Jalisco</p>
      <a class="lugar__link" href="https://maps.google.com/?q=Bogot%C3%A1+3025+Providencia+Guadalajara" target="_blank" rel="noopener">Cómo llegar →</a>
    </div>
  </section>

  <!-- CABINAS -->
  <section class="section cabinas" id="cabinas">
    <div class="wrap">
      <div class="two">
        <div class="reveal">
          <span class="eyebrow">Nueva transformación · Nuevo estilo de vida</span>
          <h2 class="h2" style="margin-top:1.2rem">Nuevos<br/>hábitos.</h2>
        </div>
        <p class="lead reveal">Marcas residentes de bienestar, cada una con su especialidad. Escríbeles directo para agendar tu cita.</p>
      </div>

      <div class="cabgrid">
        {cabinas.map((c, i) => (
          <article class={`cab reveal ${c.featured ? 'cab--fer' : ''}`} style={`transition-delay:${i * 70}ms`}>
            <span class="cab__ic"><span class="material-symbols-outlined">{c.ic}</span></span>
            <span class="cab__tag">{c.tipo || 'Cabina'}</span>
            <h3 class="cab__name">{c.n}</h3>
            <p class="cab__svc">{c.lema}</p>
            {c.desc && <p class="cab__svc">{c.desc}</p>}
            {c.dur && <span class="cab__dur">{c.dur}</span>}
            <div class="cab__contact">
              {c.waLink
                ? <a href={`https://wa.me/${c.waLink}`} target="_blank" rel="noopener">WhatsApp · {c.wa}</a>
                : <span>WhatsApp · {c.wa}</span>}
              {c.ig && (c.igLink
                ? <a class="cab__ig" href={`https://instagram.com/${c.igLink}`} target="_blank" rel="noopener">{c.ig}</a>
                : <span class="cab__ig">{c.ig}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ESPACIOS -->
  <section class="section espacios" id="espacios">
    <div class="wrap">
      <div class="two">
        <div class="reveal">
          <span class="eyebrow">Una nueva forma de hacer negocios</span>
          <h2 class="h2" style="margin-top:1.2rem">Crea tu evento<br/>o taller.</h2>
        </div>
        <p class="lead reveal">Espacios disponibles — renta por hora el escenario de tu celebración, taller o activación.</p>
      </div>

      <div class="grid-esp">
        {espacios.map((e, i) => (
          <article class="esp reveal" style={`transition-delay:${i * 80}ms`}>
            <figure class="esp__photo">
              <img src={e.foto} alt={`${e.n} · Galería 9`} loading="lazy" />
            </figure>
            <div class="esp__body">
              <div class="esp__top">
                <h3 class="h3">{e.n}</h3>
              </div>
              <p class="muted">{e.d}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="esp-cta reveal">
        <a href="/cotiza" class="btn">Empieza aquí</a>
        <span class="muted">Estimado al instante, sin compromiso.</span>
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS EVENTOS (públicos) -->
  <section class="section agenda" id="agenda" hidden>
    <div class="wrap">
      <div class="two">
        <div class="reveal">
          <span class="eyebrow">Qué está pasando</span>
          <h2 class="h2" style="margin-top:1.2rem">Próximos<br/>eventos.</h2>
        </div>
        <p class="lead reveal">Talleres, activaciones y encuentros abiertos en Galería 9. Aparta tu lugar.</p>
      </div>
      <div class="grid-ev" id="agendaGrid"></div>
    </div>
  </section>

  <!-- Modal "Me interesa" -->
  <div class="ev-modal" id="evModal" hidden>
    <div class="ev-modal__box" role="dialog" aria-modal="true" aria-labelledby="evModalT">
      <button type="button" class="ev-modal__x" id="evModalX" aria-label="Cerrar">×</button>
      <span class="eyebrow" style="color:var(--gold)">Me interesa</span>
      <h3 class="h3" id="evModalT" style="margin:.6rem 0 .3rem">Evento</h3>
      <p class="muted" id="evModalD" style="margin-bottom:1.4rem"></p>
      <form id="evForm" novalidate>
        <label class="cfield"><span>Tu nombre</span><input type="text" name="nombre" placeholder="Nombre" required /></label>
        <label class="cfield"><span>WhatsApp</span><input type="tel" name="telefono" placeholder="33 0000 0000" required /></label>
        <label class="cfield"><span>Correo <i>(opcional)</i></span><input type="email" name="correo" placeholder="tu@correo.com" /></label>
        <button type="submit" class="btn" style="margin-top:.6rem;width:100%">Quiero asistir</button>
      </form>
      <div class="ev-modal__done" id="evDone" hidden>
        <div class="contacto__mark">✓</div>
        <p class="lead">¡Listo! Te avisamos los detalles por WhatsApp.</p>
      </div>
    </div>
  </div>

  <!-- MARCAS -->
  <section class="section marcas" id="marcas">
    <div class="wrap">
      <div class="two">
        <div class="reveal">
          <span class="eyebrow">Para marcas</span>
          <h2 class="h2" style="margin-top:1.2rem">Expándete en<br/>Galería 9.</h2>
        </div>
        <p class="lead reveal">Estrategias de visibilidad y expansión. Toma acción, activa tu marca y comienza ahora.</p>
      </div>

      <a class="pp-card reveal" href="/#contacto" data-interes="Punto Presencia">
        <figure class="pp-card__media">
          <img src={puntoPresencia.foto} alt="Punto Presencia · el Market de Galería 9" loading="lazy" />
        </figure>
        <div class="pp-card__body">
          <span class="marca__meta">{puntoPresencia.meta}</span>
          <h3 class="h2" style="font-size:clamp(1.6rem,3vw,2.2rem)">{puntoPresencia.n}</h3>
          <p class="muted">{puntoPresencia.d}</p>
          <span class="marca__cta">Me interesa →</span>
        </div>
      </a>

      <div class="grid-marcas">
        {marcas.map((m, i) => (
          <a class="marca reveal" href={m.href || '/#contacto'} data-interes={m.n} style={`transition-delay:${i * 80}ms`}>
            {m.foto && (
              <figure class="marca__media">
                <img src={m.foto} alt={`${m.n} · Galería 9`} loading="lazy" />
              </figure>
            )}
            <div class="marca__body">
              <div class="marca__top">
                <h3 class="h3">{m.n}</h3>
                <span class="marca__meta">{m.meta}</span>
              </div>
              <p class="muted">{m.d}</p>
              <span class="marca__cta">Me interesa →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="cta-band" id="contacto">
    <div class="wrap contacto__grid">
      <div class="contacto__copy reveal">
        <span class="eyebrow" style="color:var(--gold)">Contacto</span>
        <h2 class="h2" style="margin-top:1rem">Platiquemos.</h2>
        <p class="lead">¿Una duda, una idea, una colaboración? Escríbenos y te respondemos muy pronto.</p>
        <p class="contacto__alt">¿Ya sabes qué quieres? <a href="/cotiza" class="link-arrow contacto__alt-link">Cotiza tu evento →</a></p>
        <p class="contacto__alt">¿Prefieres verla en persona? <button type="button" class="link-arrow contacto__alt-link cal-plain" data-cal-link="galeria-9-raembd/visita-galeria-9" data-cal-namespace="visita" data-cal-config='{"layout":"month_view","theme":"light"}'>Agenda una visita →</button></p>
      </div>

      <form id="leadForm" class="contacto__form reveal" novalidate>
        <div class="cfields">
          <label class="cfield"><span>Tu nombre</span><input type="text" name="nombre" placeholder="Nombre" required /></label>
          <label class="cfield"><span>WhatsApp</span><input type="tel" name="telefono" placeholder="33 0000 0000" required /></label>
          <label class="cfield"><span>Correo <i>(opcional)</i></span><input type="email" name="correo" placeholder="tu@correo.com" /></label>
          <label class="cfield"><span>Me interesa</span>
            <select name="interes" required>
              <option value="">Elige…</option>
              <option>Evento</option>
              <option>Punto Presencia</option>
              <option>Pop Up</option>
              <option>Tu Talento es un Arte</option>
              <option>Tester Day</option>
              <option>Invitado Especial</option>
              <option>Cabinas · Bienestar</option>
              <option>Otro</option>
            </select>
          </label>
          <label class="cfield cfield--wide"><span>Tu mensaje</span><textarea name="mensaje" rows="3" placeholder="Cuéntanos…" required></textarea></label>
        </div>
        <button type="submit" class="btn btn--invert">Enviar mensaje</button>
      </form>

      <div class="contacto__done reveal" id="leadDone" hidden>
        <div class="contacto__mark">✓</div>
        <h2 class="h2">¡Recibido!</h2>
        <p class="lead">Te contactamos muy pronto por WhatsApp.</p>
        <button type="button" class="btn btn--ghost" style="margin-top:1.2rem" data-cal-link="galeria-9-raembd/visita-galeria-9" data-cal-namespace="visita" data-cal-config='{"layout":"month_view","theme":"light"}'>Agenda una visita a Galería 9</button>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/calPopup.js';
    import { T, crear, leerEventosPublicos } from '../config.js';
    const lf = document.getElementById('leadForm');

    // ---- Próximos eventos públicos ----
    const escEv = (s) => String(s ?? '').replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
    (async () => {
      let eventos = [];
      try { eventos = await leerEventosPublicos(); } catch { return; }
      if (!eventos.length) return;

      const fmtEv = (ini, fin) => {
        if (!ini) return '';
        const a = new Date(ini);
        const dia = a.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });
        const hIni = a.toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' });
        const hFin = fin ? new Date(fin).toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' }) : '';
        return `${dia} · ${hIni}${hFin ? ` – ${hFin}` : ''}`;
      };

      const grid = document.getElementById('agendaGrid');
      grid.innerHTML = eventos.map((e, i) => `
        <article class="ev-card reveal in">
          ${e.imagen ? `<figure class="ev-card__media"><img src="${escEv(e.imagen)}" alt="${escEv(e.titulo)}" loading="lazy" /></figure>` : ''}
          <div class="ev-card__body">
            <span class="ev-card__date">${escEv(fmtEv(e.inicio, e.fin))}</span>
            <h3 class="h3">${escEv(e.titulo)}</h3>
            ${e.espacios.length ? `<span class="ev-card__place">${escEv(e.espacios.join(' · '))}</span>` : ''}
            ${e.descripcion ? `<p class="muted">${escEv(e.descripcion)}</p>` : ''}
            <button type="button" class="btn ev-card__btn"
              data-id="${escEv(e.id)}" data-t="${escEv(e.titulo)}" data-d="${escEv(fmtEv(e.inicio, e.fin))}">Me interesa</button>
          </div>
        </article>`).join('');
      document.getElementById('agenda').hidden = false;

      // Modal "Me interesa"
      const modal = document.getElementById('evModal');
      const evForm = document.getElementById('evForm');
      const evDone = document.getElementById('evDone');
      let tituloSel = '', idSel = '';
      const abrir = (id, t, d) => {
        idSel = id; tituloSel = t;
        document.getElementById('evModalT').textContent = t;
        document.getElementById('evModalD').textContent = d;
        evForm.hidden = false; evDone.hidden = true; evForm.reset();
        modal.hidden = false; document.body.style.overflow = 'hidden';
      };
      const cerrar = () => { modal.hidden = true; document.body.style.overflow = ''; };
      grid.querySelectorAll('.ev-card__btn').forEach((b) =>
        b.addEventListener('click', () => abrir(b.dataset.id, b.dataset.t, b.dataset.d)));
      document.getElementById('evModalX').addEventListener('click', cerrar);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });

      evForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(evForm);
        const g = (k) => (fd.get(k) || '').toString().trim();
        // Bloqueo explícito (no solo reportValidity): nombre y WhatsApp obligatorios.
        if (!g('nombre') || !g('telefono')) { evForm.reportValidity(); return; }
        const btn = evForm.querySelector('[type=submit]');
        btn.disabled = true; btn.textContent = 'Enviando…';
        try {
          await crear(T.interesados, {
            Nombre: g('nombre'),
            WhatsApp: g('telefono'),
            Correo: g('correo') || undefined,
            Evento: idSel ? [idSel] : undefined,
          });
          evForm.hidden = true; evDone.hidden = false;
        } catch (err) {
          btn.disabled = false; btn.textContent = 'Quiero asistir';
          alert('No pudimos registrarte. Intenta de nuevo.');
          console.error(err);
        }
      });
    })();

    // Cards de marcas → llevan al form con el interés pre-seleccionado
    document.querySelectorAll('[data-interes]').forEach((el) =>
      el.addEventListener('click', () => {
        const sel = lf?.elements['interes'];
        if (sel) sel.value = el.dataset.interes;
      })
    );
    lf?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!lf.reportValidity()) return;
      const fd = new FormData(lf);
      const g = (k) => (fd.get(k) || '').toString().trim();
      const btn = lf.querySelector('[type=submit]');
      btn.disabled = true; btn.textContent = 'Enviando…';
      try {
        await crear(T.leads, {
          Nombre: g('nombre'),
          WhatsApp: g('telefono'),
          Correo: g('correo') || undefined,
          Interes: g('interes'),
          Mensaje: g('mensaje'),
          Estatus: 'Nuevo',
        });
        lf.hidden = true;
        document.querySelector('.contacto__copy').hidden = true;
        document.getElementById('leadDone').hidden = false;
      } catch (err) {
        btn.disabled = false; btn.textContent = 'Enviar mensaje';
        alert('No pudimos enviar tu mensaje. Escríbenos por WhatsApp.');
        console.error(err);
      }
    });
  </script>
</Base>

<style>
  /* Próximos eventos: las CARDS se inyectan por JS (sin scope de Astro), así
     que sus estilos van en un bloque is:global al final del archivo. Aquí solo
     lo estático del componente. */
  .grid-ev { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.8rem; margin-top: 2.5rem; }

  .ev-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 1.5rem; background: rgba(43,43,42,.55); backdrop-filter: blur(3px); }
  .ev-modal__box { position: relative; width: 100%; max-width: 420px; background: var(--paper); border-radius: var(--radius); padding: 2rem; box-shadow: 0 30px 80px -20px rgba(43,43,42,.5); }
  .ev-modal__x { position: absolute; top: .8rem; right: 1rem; background: none; border: 0; font-size: 1.6rem; line-height: 1; color: var(--ink-45); cursor: pointer; }
  .ev-modal__x:hover { color: var(--ink); }
  .ev-modal__done { text-align: center; padding: 1rem 0; }
  .ev-modal .cfield { margin-bottom: 1rem; }
  .ev-modal .cfield > span { color: var(--ink-70, rgba(43,43,42,.7)); }
  /* El modal es CLARO: los inputs de .cfield están hechos para la banda oscura
     (texto/borde claros → invisibles aquí). Se re-visten para fondo claro. */
  .ev-modal .cfield input, .ev-modal .cfield textarea {
    color: var(--ink); background: var(--white);
    border: 1px solid var(--ink-12);
  }
  .ev-modal .cfield input::placeholder { color: var(--ink-45); }
  .ev-modal .cfield input:focus { border-color: var(--ink); }

  .hero { position: relative; overflow: clip; padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6.5rem); }
  .hero__inner { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero .display { margin-top: 1.6rem; }
  .hero__lead { max-width: 34ch; margin-top: 2rem; }
  .hero__cta { display: flex; align-items: center; gap: 2rem; margin-top: 2.8rem; flex-wrap: wrap; }
  .hero__photo { margin: 0; overflow: hidden; border-radius: var(--radius); max-height: min(72vh, 620px); }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; margin-bottom: clamp(3rem, 6vw, 5rem); }

  .exp-body { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .exp-photo { margin: 0; }
  .exp-photo img { width: 100%; max-height: 520px; object-fit: cover; display: block; border-radius: var(--radius); }
  .exp-photo figcaption {
    margin-top: .7rem; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-45);
  }
  .pilares { display: grid; grid-template-columns: 1fr; gap: clamp(1.5rem, 3vw, 2.4rem); }
  .pilar { border-top: 1px solid var(--ink); padding-top: 1.4rem; }
  .pilar__num { font-size: .8rem; letter-spacing: .2em; color: var(--gold-ink); }
  .pilar h3 { margin: 1.2rem 0 .8rem; }
  .pilar__lema { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-ink); margin-left: .8em; white-space: nowrap; }

  .cabgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .cab {
    display: flex; flex-direction: column; gap: .5rem;
    padding: 1.6rem 1.4rem; min-height: 210px;
    border: 1px solid var(--ink-12); border-radius: var(--radius); background: var(--white);
    transition: border-color .3s var(--ease), transform .3s var(--ease);
  }
  .cab:hover { border-color: var(--ink-45); transform: translateY(-3px); }
  .cab__ic {
    width: 42px; height: 42px; border-radius: 11px; background: var(--sand);
    display: grid; place-items: center; color: var(--gold-ink); margin-bottom: .5rem;
  }
  .cab__ic .material-symbols-outlined { font-size: 22px; }
  .cab--fer .cab__ic { background: rgba(255, 255, 255, .09); color: var(--gold); }
  .cab__tag { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-ink); }
  .cab__name { font-size: 1.4rem; font-weight: 300; margin: .2rem 0; }
  .cab__svc { font-size: .88rem; color: var(--ink-70); line-height: 1.4; }
  .cab__dur { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-ink); margin-top: .25rem; }
  .cab--fer .cab__dur { color: var(--gold); }
  .cab__contact { margin-top: auto; display: flex; flex-direction: column; gap: .2rem; font-size: .78rem; color: var(--ink-70); letter-spacing: .01em; }
  .cab__contact a { transition: color .3s var(--ease); }
