---
import Base from '../layouts/Base.astro';
import Agenda from '../components/Agenda.astro';
import Contacto from '../components/Contacto.astro';

// Las 3 puertas del home: cada una lleva a su página.
const puertas = [
  { t: 'Transformación', sub: 'Consciencia y hábitos', d: 'Hábitos conscientes para un nuevo estilo de vida.', foto: '/fotos/evento-roof.jpg', href: '/habitos' },
  { t: 'Conexión', sub: 'Espacios y eventos', d: 'Experiencias privadas y activaciones para tu marca personal o profesional.', foto: '/fotos/evento-terraza.jpg', href: '/espacios' },
  { t: 'Expansión', sub: 'Comunicación y estrategias', d: 'Expresa tu talento, con la estrategia y el acompañamiento de una agencia.', foto: '/fotos/tu-talento.png', href: '/estrategias' },
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <span class="eyebrow reveal">Guadalajara · Market de Talentos</span>
        <h1 class="display reveal">Un punto de<br/>encuentro<br/>para marcas<br/>en expansión.</h1>
        <p class="lead hero__lead reveal">Galería 9 es un espacio de expansión en donde marcas y personas se expresan y comparten su esencia a través de la conexión con su talento.</p>
        <div class="hero__cta reveal">
          <a href="/cotiza" class="btn">Cotiza tu evento</a>
          <a href="/#puertas" class="link-arrow">Conoce la casa →</a>
        </div>
      </div>
      <figure class="hero__photo reveal">
        <img src="/fotos/punto-presencia-2.jpg" alt="El Market de Galería 9" />
      </figure>
    </div>
  </section>

  <!-- LAS 3 PUERTAS -->
  <section class="puertas" id="puertas">
    <div class="wrap puertas__grid">
      {puertas.map((p, i) => (
        <a class="puerta reveal" href={p.href} style={`transition-delay:${i * 90}ms`}>
          <figure class="puerta__media">
            <img src={p.foto} alt={`${p.t} · Galería 9`} loading="lazy" />
          </figure>
          <div class="puerta__body">
            <span class="puerta__num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="puerta__t">{p.t}</h2>
            <span class="puerta__sub">{p.sub}</span>
            <p class="muted">{p.d}</p>
            <span class="puerta__cta">Conoce más →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- EL LUGAR · interludio full-bleed -->
  <section class="lugar" id="lugar">
    <img src="/fotos/roof-2.jpg" alt="El roof de Galería 9" loading="lazy" />
    <div class="lugar__overlay reveal">
      <span class="eyebrow lugar__eyebrow">El lugar</span>
      <p class="lugar__addr">Bogotá 3025 · Providencia<br/>Guadalajara, Jalisco</p>
      <a class="lugar__link" href="https://maps.google.com/?q=Bogot%C3%A1+3025+Providencia+Guadalajara" target="_blank" rel="noopener">Cómo llegar →</a>
    </div>
  </section>

  <!-- PRÓXIMOS EVENTOS (carrusel + "Ver todos") -->
  <Agenda />

  <Contacto />
</Base>

<style>
  .hero { position: relative; overflow: clip; padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6.5rem); }
  .hero__inner { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero .display { margin-top: 1.6rem; }
  .hero__lead { max-width: 34ch; margin-top: 2rem; }
  .hero__cta { display: flex; align-items: center; gap: 2rem; margin-top: 2.8rem; flex-wrap: wrap; }
  .hero__photo { margin: 0; overflow: hidden; border-radius: var(--radius); max-height: min(72vh, 620px); }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Las 3 puertas */
  .puertas { background: var(--sand); padding-block: clamp(3.5rem, 8vw, 6rem); }
  .puertas__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .puerta {
    display: flex; flex-direction: column; background: var(--white);
    border: 1px solid var(--ink-12); border-radius: var(--radius); overflow: hidden;
    transition: border-color .3s var(--ease), transform .3s var(--ease);
  }
  .puerta:hover { border-color: var(--ink); transform: translateY(-4px); }
  .puerta__media { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  .puerta__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s var(--ease); }
  .puerta:hover .puerta__media img { transform: scale(1.05); }
  .puerta__body { display: flex; flex-direction: column; gap: .45rem; padding: clamp(1.4rem, 2.4vw, 2rem); flex: 1; }
  .puerta__num { font-size: .75rem; letter-spacing: .2em; color: var(--gold-ink); }
  .puerta__t { font-size: clamp(1.5rem, 2.4vw, 1.9rem); font-weight: 300; line-height: 1.1; margin: .2rem 0 0; }
  .puerta__sub { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-ink); }
  .puerta .muted { font-size: .92rem; margin-top: .4rem; flex: 1; }
  .puerta__cta { margin-top: .6rem; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 500; color: var(--ink); }

  /* Interludio full-bleed "El lugar" — velo uniforme + contenido centrado */
  .lugar { position: relative; height: clamp(300px, 44vh, 440px); overflow: hidden; background: var(--ink); }
  .lugar > img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .55; }
  .lugar__overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .9rem; text-align: center; padding: 2rem var(--gutter);
    color: var(--paper);
  }
  .lugar__eyebrow { color: var(--gold); }
  .lugar__addr { font-size: clamp(1.3rem, 2.8vw, 2rem); font-weight: 200; line-height: 1.35; letter-spacing: .01em; }
  .lugar__link {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 500;
    color: var(--paper); border-bottom: 1px solid rgba(242,242,242,.35); padding-bottom: .35em;
    transition: border-color .3s var(--ease);
  }
  .lugar__link:hover { border-color: var(--paper); }

  @media (max-width: 900px) { .puertas__grid { grid-template-columns: 1fr; } .puerta__media { aspect-ratio: 16 / 9; } }
  @media (max-width: 760px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__photo { max-height: 340px; order: -1; }
  }
</style>
