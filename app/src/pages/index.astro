  .lugar__eyebrow { color: var(--gold); }
  .lugar__addr { font-size: clamp(1.3rem, 2.8vw, 2rem); font-weight: 200; line-height: 1.35; letter-spacing: .01em; }
  .lugar__link {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 500;
    color: var(--paper); border-bottom: 1px solid rgba(242,242,242,.35); padding-bottom: .35em;
    transition: border-color .3s var(--ease);
  }
  .lugar__link:hover { border-color: var(--paper); }

  .espacios { background: var(--sand); }
  .grid-esp { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--ink-12); border: 1px solid var(--ink-12); }
  .esp { background: var(--sand); display: flex; flex-direction: column; }
  .esp__photo { margin: 0; overflow: hidden; aspect-ratio: 16 / 9; }
  .esp__photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s var(--ease); }
  .esp:hover .esp__photo img { transform: scale(1.04); }
  .esp__body { padding: clamp(1.4rem, 2.6vw, 2.2rem); }
  .esp__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .8rem; }
  .esp__cap { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-ink); white-space: nowrap; }
  .esp-cta { display: flex; align-items: center; gap: 1.4rem; margin-top: clamp(1.8rem, 4vw, 2.6rem); flex-wrap: wrap; }
  .esp-cta .muted { font-size: .88rem; }

  .cta-band { background: var(--ink); color: var(--paper); padding-block: clamp(4rem, 8vw, 6.5rem); }
  .cta-band .h2 { color: var(--paper); }
  .cta-band .lead { color: rgba(242,242,242,.7); margin-top: 1.2rem; max-width: 40ch; }
  .btn--invert { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .btn--invert:hover { background: transparent; color: var(--paper); }

  .contacto__grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .contacto__alt { margin-top: 2.2rem; font-size: .95rem; color: rgba(242,242,242,.55); }
  .contacto__alt-link { color: var(--paper); border-color: rgba(242,242,242,.3); margin-left: .5rem; font-size: .78rem; }
  .cal-plain { background: none; border: 0; padding: 0; font-family: inherit; cursor: pointer; }
  .cfields { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.2rem; margin-bottom: 1.6rem; }
  .cfield { display: flex; flex-direction: column; gap: .45rem; }
  .cfield--wide { grid-column: 1 / -1; }
  .cfield > span { font-size: .78rem; letter-spacing: .06em; color: rgba(242,242,242,.6); }
  .cfield i { font-style: normal; opacity: .6; }
  .cfield input, .cfield select, .cfield textarea {
    font-family: var(--sans); font-size: 1rem; color: var(--paper);
    padding: .85em 1em; border: 1px solid rgba(242,242,242,.18); border-radius: var(--radius);
    background: rgba(255,255,255,.06); transition: border-color .3s var(--ease); resize: vertical;
  }
  .cfield input::placeholder, .cfield textarea::placeholder { color: rgba(242,242,242,.35); }
  .cfield select { color: var(--paper); }
  .cfield select option { color: var(--ink); background: var(--paper); }
  .cfield input:focus, .cfield select:focus, .cfield textarea:focus { outline: none; border-color: var(--gold); }
  .contacto__done { grid-column: 1 / -1; text-align: center; padding-block: 2rem; }
  .contacto__mark { width: 64px; height: 64px; border-radius: 50%; background: var(--gold); color: var(--ink); display: grid; place-items: center; font-size: 1.8rem; margin: 0 auto 1.4rem; }
  .contacto__done .lead { margin-inline: auto; }

  @media (max-width: 980px) { .cabgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .two { grid-template-columns: 1fr; align-items: start; }
    .hero__inner { grid-template-columns: 1fr; }
    .hero__photo { max-height: 340px; order: -1; }
    .exp-body { grid-template-columns: 1fr; }
    .exp-photo { max-height: 380px; }
    .grid-esp { grid-template-columns: 1fr; }
    .pp-card { grid-template-columns: 1fr; }
    .pp-card__media { min-height: 220px; }
    .grid-marcas { grid-template-columns: 1fr; }
    .contacto__grid { grid-template-columns: 1fr; }
    .cfields { grid-template-columns: 1fr; }
    .cabgrid { grid-template-columns: 1fr; }
  }
</style>

<!-- Cards de eventos: inyectadas por JS → estilos globales (sin scope Astro) -->
<style is:global>
  .ev-card {
    display: flex; flex-direction: column; background: var(--white);
    border: 1px solid var(--ink-12); border-radius: var(--radius); overflow: hidden;
    box-shadow: 0 1px 2px rgba(43,43,42,.04), 0 12px 30px -18px rgba(43,43,42,.25);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .ev-card:hover { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(43,43,42,.05), 0 22px 44px -20px rgba(43,43,42,.38); }
  .ev-card__media { margin: 0; aspect-ratio: 3/2; overflow: hidden; background: var(--sand); }
  .ev-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .ev-card:hover .ev-card__media img { transform: scale(1.04); }
  .ev-card__body { display: flex; flex-direction: column; gap: .55rem; padding: 1.5rem; flex: 1; }
  .ev-card__date { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-ink); font-weight: 600; line-height: 1.4; }
  .ev-card__body .h3 { margin: .15rem 0; }
  .ev-card__place { display: inline-block; font-size: .72rem; letter-spacing: .04em; color: var(--ink-45); padding: .15em .6em; border: 1px solid var(--ink-12); border-radius: 999px; align-self: flex-start; }
  .ev-card__body .muted { font-size: .88rem; line-height: 1.55; }
  /* margin-top:auto pega el botón al fondo del body: queda SIEMPRE a la misma
