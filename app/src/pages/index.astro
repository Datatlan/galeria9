---
import Base from '../layouts/Base.astro';
import Agenda from '../components/Agenda.astro';
import Contacto from '../components/Contacto.astro';

// Las 3 puertas del home: cada una lleva a su página.
// Íconos vectoriales extraídos de "website design.pdf" (public/home/ic-*.svg).
const puertas = [
  { t: 'Transformación', sub: 'Consciencia y hábitos', ic: 'corazon', bg: '#d3d0ce', href: '/habitos' },
  { t: 'Conexión', sub: 'Espacios y eventos', ic: 'pulso', bg: '#dad1bd', href: '/estrategias' },
  { t: 'Expansión', sub: 'Comunicación y estrategias', ic: 'mente', bg: '#e4dfd8', href: '/agencia' },
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title reveal">Un punto de<br/>encuentro para tu<br/><em>expansión</em></h1>
        <p class="hero__kicker reveal">Market de Talentos</p>
      </div>
      <img class="hero__logo reveal" src="/logo.png" alt="Galería 9 · Market de Talentos" width="499" height="948" />
    </div>
  </section>

  <!-- LAS 3 PUERTAS -->
  <section class="puertas" id="puertas">
    <div class="wrap">
      <p class="puertas__intro reveal">siente, elige y toma acción…</p>
      <div class="puertas__grid">
        {puertas.map((p, i) => (
          <a class="puerta reveal" href={p.href} style={`--bg:${p.bg}; transition-delay:${i * 90}ms`}>
            <h2 class="puerta__t">{p.t}</h2>
            <span class="puerta__sub">{p.sub}</span>
            <img class="puerta__ic" src={`/home/ic-${p.ic}.svg`} alt="" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EL LUGAR · interludio full-bleed -->
  <section class="lugar" id="lugar">
    <img src="/fotos/roof-2.jpg" alt="El roof de Galería 9" loading="lazy" />
    <div class="lugar__overlay reveal">
      <span class="eyebrow lugar__eyebrow">El lugar</span>
      <p class="lugar__addr">Bogotá 3025 · Providencia<br/>Guadalajara, Jalisco</p>
      <a class="lugar__link" href="https://maps.google.com/?q=Bogot%C3%A1+3025+Providencia+Guadalajara" target="_blank" rel="noopener">Cómo llegar →</a>
    </div>
  </section>

  <!-- PRÓXIMOS EVENTOS (carrusel + "Ver todos") -->
  <Agenda />

  <Contacto />
</Base>

<style>
  /* Hero — diseño "website design.pdf": título Thin + itálica, kicker dorado, logo grande a la derecha */
  .hero { position: relative; overflow: clip; min-height: min(78vh, 760px); display: grid; align-items: center; padding-block: clamp(3rem, 7vw, 5rem); }
  .hero__inner { display: grid; grid-template-columns: 1fr auto; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .hero__title { font-size: clamp(2.6rem, 6.25vw, 5.4rem); font-weight: 100; line-height: .94; letter-spacing: -.015em; }
  .hero__title em { font-style: italic; font-weight: 100; }
  .hero__kicker { margin: clamp(1.6rem, 3vw, 2.4rem) 0 0 .1em; font-size: clamp(.9rem, 1.1vw, 1rem); font-weight: 700; letter-spacing: .01em; text-transform: uppercase; color: var(--gold); }
  .hero__logo { width: clamp(120px, 15.8vw, 220px); height: auto; margin-right: clamp(0rem, 4vw, 4rem); }

  /* Las 3 puertas — tarjetas de color con ícono de línea (website design.pdf) */
  .puertas { padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 9vw, 7rem); }
  .puertas__intro { font-size: clamp(1.4rem, 2.3vw, 1.8rem); font-weight: 200; letter-spacing: -.01em; margin: 0 0 clamp(1.4rem, 2.6vw, 2.2rem); }
  .puertas__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.9rem, 1.9vw, 1.5rem); }
  .puerta {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    aspect-ratio: 275 / 342; padding: clamp(2.2rem, 6vw, 4.4rem) 1.2rem clamp(1.8rem, 4vw, 3rem);
    background: var(--bg); border-radius: clamp(20px, 2.8vw, 34px); color: var(--ink);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .puerta:hover { transform: translateY(-6px); box-shadow: 0 22px 40px -26px rgba(43,43,42,.45); }
  .puerta__t { font-size: clamp(1.25rem, 2.35vw, 2rem); font-weight: 700; line-height: 1; letter-spacing: -.005em; text-transform: uppercase; }
  .puerta__sub { margin-top: .35em; font-size: clamp(.95rem, 1.6vw, 1.35rem); font-weight: 300; line-height: 1.05; text-transform: uppercase; }
  .puerta__ic { margin-block: auto; width: 58%; max-height: 50%; object-fit: contain; transition: transform .5s var(--ease); }
  .puerta:hover .puerta__ic { transform: scale(1.05); }

  /* Interludio full-bleed "El lugar" — velo uniforme + contenido centrado */
  .lugar { position: relative; height: clamp(300px, 44vh, 440px); overflow: hidden; background: var(--ink); }
  .lugar > img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .55; }
  .lugar__overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .9rem; text-align: center; padding: 2rem var(--gutter);
    color: var(--paper);
  }
  .lugar__eyebrow { color: var(--gold); }
  .lugar__addr { font-size: clamp(1.3rem, 2.8vw, 2rem); font-weight: 200; line-height: 1.35; letter-spacing: .01em; }
  .lugar__link {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 500;
    color: var(--paper); border-bottom: 1px solid rgba(242,242,242,.35); padding-bottom: .35em;
    transition: border-color .3s var(--ease);
  }
  .lugar__link:hover { border-color: var(--paper); }

  @media (max-width: 760px) {
    .puertas__grid { grid-template-columns: 1fr; }
    .puerta { aspect-ratio: auto; min-height: 0; padding-block: 2rem 1.7rem; }
    .puerta__t { font-size: 1.7rem; }
    .puerta__sub { font-size: 1.1rem; }
    .puerta__ic { width: auto; height: 112px; max-width: 60%; max-height: none; margin: 1.4rem 0 0; }
  }
  @media (max-width: 760px) {
    .hero { min-height: auto; }
    .hero__inner { grid-template-columns: 1fr; gap: 2.2rem; }
    .hero__logo { order: -1; width: 92px; margin: 0; }
  }
</style>
