---
// 05 · Agencia (v3): servicio "Expresa tu talento + agencia". Encuesta de UNA
// opción entre los 4 servicios de "¿cómo ser parte de Galería 9?" (PDF del
// cliente) + datos de contacto → Leads, Interes = Agencia, Prioridades = la
// tarjeta elegida. Es la tercera puerta del home (Expansión).
import Base from '../layouts/Base.astro';

const servicios = [
  {
    v: 'Visibilidad de tu Talento', k: 'Identidad visual',
    items: ['exploración de memorias del inconsciente', 'definición de paletas de colores', 'selección de tipografías', 'renders y visualización de tu producto', 'propuesta de identidad visual para tu talento'],
    frase: 'haz visible lo que te hace único.', pie: 'duración: 1 semana',
  },
  {
    v: 'Estructura tu Expansión', k: 'Dirección, estrategia y estructura',
    items: ['4 de memorias del inconsciente', 'identificación de talentos, fortalezas y potencial', 'definición de visión y objetivos de expansión', 'identificación de oportunidades de crecimiento', 'diseño de estrategias y próximos pasos', 'mapa de expansión digital y físico', 'ruta de acción personalizada para tu negocio'],
    frase: 'un mapa para desarrollar tu negocio', pie: 'proyecto de 2 semanas',
  },
  {
    v: 'Campaña Digital', checks: ['una visión', 'un análisis', 'visibilidad'], pie: '1 META',
  },
  {
    v: 'Experiencia Galería 9', intro: 'un diseño a tu medida:',
    items: ['celebración personal', 'colaboraciones', 'tu producto', 'tus clientes', 'tu empresa'],
    frase: 'tu talento es una experiencia',
  },
];
---
<Base title="Expresa tu talento + agencia — Galería 9" description="Elige lo que buscas para tu marca: identidad visual, estructura de expansión, campaña digital o una experiencia en Galería 9.">
  <section class="section">
    <div class="wrap">
      <header class="mhead reveal">
        <span class="eyebrow">Expansión · Comunicación y estrategias</span>
        <h1 class="h2" style="margin-top:1rem">Expresa tu talento<br/>+ agencia.</h1>
      </header>

      <form id="f" class="mform ag__form" novalidate>
        <fieldset class="opt-group ag__busca reveal">
          <legend class="ag__q">¿Qué estás buscando?</legend>
          <div class="ag__cards">
            {servicios.map((s) => (
              <label class={`svc ${s.k ? 'svc--lista' : 'svc--centro'}`}>
                <input type="radio" name="busca" value={s.v} />
                <span class="svc__in">
                  <span class="svc__check" aria-hidden="true"></span>
                  {s.k && <span class="svc__k">{s.k}</span>}
                  <span class="svc__t">{s.v}</span>
                  {s.intro && <span class="svc__intro">{s.intro}</span>}
                  {s.items && <ul class={`svc__list${s.items.length > 5 ? ' svc__list--largo' : ''}`}>{s.items.map((i) => <li>{i}</li>)}</ul>}
                  {s.checks && (
                    <ul class="svc__checks">
                      {s.checks.map((i) => (
                        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="16" height="16" rx="2" /><path d="M6 13l4 4 11-12" /></svg>{i}</li>
                      ))}
                    </ul>
                  )}
                  {s.frase && <span class="svc__frase">{s.frase}</span>}
                  {s.pie && <span class={`svc__tag${s.checks ? ' svc__tag--meta' : ''}`}>{s.pie}</span>}
                  <img class="svc__logo" src="/logo.png" alt="" width="499" height="948" loading="lazy" />
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mform-two ag__datos reveal">
          <label class="mfield"><span>Nombre</span><input type="text" name="nombre" placeholder="Tu nombre" required /></label>
          <label class="mfield"><span>Celular / WhatsApp</span><input type="tel" name="telefono" placeholder="33 0000 0000" required /></label>
          <label class="mfield mfield--wide"><span>Correo electrónico</span><input type="email" name="correo" placeholder="tu@correo.com" required /></label>
          <label class="mfield mfield--wide"><span>Giro de negocio o talento</span><input type="text" name="giro" placeholder="Ej. Joyería artesanal, coaching, repostería…" required /></label>
          <label class="mfield mfield--wide"><span>Link de Instagram</span><input type="text" name="instagram" placeholder="instagram.com/tumarca" required /></label>
        </div>

        <div><button type="submit" class="btn">Enviar</button></div>
      </form>

      <div class="mdone" id="done" hidden>
        <div class="mdone__mark">✓</div>
        <h2 class="h2">¡Recibimos tus datos!</h2>
        <p class="lead">Te contactamos muy pronto para platicar de tu marca.</p>
        <div class="mdone__actions">
          <a href="/" class="btn btn--ghost">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initLeadForm, lineas, grupoObligatorio } from '../scripts/leadForm.js';
    const form = document.getElementById('f');
    const elegida = grupoObligatorio(form, 'busca');

    initLeadForm({
      validate: () => elegida(),
      build: (g) => ({
        interes: 'Agencia',
        detalle: lineas([
          ['Busca', g('busca')],
          ['Giro / talento', g('giro')],
          ['Instagram', g('instagram')],
        ]),
        extra: { Prioridades: [g('busca')] },
      }),
    });
  </script>
</Base>

<style>
  .ag__form { max-width: none; gap: clamp(2rem, 4vw, 2.8rem); }
  .ag__datos { max-width: 640px; }
  .ag__q { font-size: clamp(1.5rem, 2.4vw, 1.9rem); font-weight: 300; letter-spacing: -.01em; color: var(--ink); margin-bottom: 1.4rem; }

  /* Tarjetas = las páginas del PDF "¿cómo ser parte de Galería 9?" (819×1456).
     La tarjeta es un contenedor: todo se mide en cqw (1cqw = 8.19 px del PDF), así
     escala como una pieza de diseño y no se reacomoda como contenido web. Se elige UNA. */
  .ag__cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(.9rem, 1.6vw, 1.3rem); }
  .svc {
    position: relative; display: block; container-type: inline-size; aspect-ratio: 819 / 1456;
    background: #c4b496; color: #2b2b2a; border-radius: 12px; overflow: hidden; cursor: pointer;
    font-family: "Helvetica Neue", "Inter", Helvetica, Arial, sans-serif;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .svc:hover { transform: translateY(-4px); }
  .svc input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .svc:has(input:checked) { box-shadow: 0 0 0 3px var(--ink); transform: translateY(-4px); }
  .svc:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; }
  .opt-group.invalid .svc { box-shadow: 0 0 0 2px #b4523f; }

  .svc__in { position: absolute; inset: 0; display: flex; flex-direction: column; padding: 28cqw 10cqw 0 11cqw; }
  .svc__check {
    position: absolute; top: 5cqw; left: 5cqw; width: max(18px, 5.5cqw); height: max(18px, 5.5cqw); border-radius: 50%;
    border: 1.5px solid rgba(43, 43, 42, .5); background: rgba(255, 255, 255, .3);
    display: grid; place-items: center; transition: background .2s, border-color .2s;
  }
  .svc:has(input:checked) .svc__check { background: var(--ink); border-color: var(--ink); }
  .svc:has(input:checked) .svc__check::after { content: ''; width: 36%; height: 20%; border: 2px solid #fff; border-top: 0; border-right: 0; transform: rotate(-45deg) translate(6%, -12%); }

  /* Etiqueta, título, viñetas */
  .svc__k { align-self: flex-end; text-align: right; font-size: 3.3cqw; line-height: 1; letter-spacing: -.07em; text-transform: uppercase; }
  .svc__t { margin: 10cqw 0 0 3cqw; font-size: 6.8cqw; font-weight: 700; line-height: 1; letter-spacing: -.06em; white-space: nowrap; }
  .svc__list { list-style: none; margin: 8.5cqw 8cqw 0 9cqw; padding: 0; display: flex; flex-direction: column; gap: 4.5cqw; }
  .svc__list li { position: relative; padding-left: 3.4cqw; font-size: 5.4cqw; font-weight: 300; line-height: .82; letter-spacing: -.06em; }
  .svc__list li::before { content: ''; position: absolute; left: 0; top: .32em; width: 1.1cqw; height: 1.1cqw; border-radius: 50%; background: currentColor; }

  /* Pastillas: frase clara + duración oscura */
  .svc__frase { align-self: flex-start; white-space: nowrap; margin-top: 6.3cqw; padding: .12em .42em .16em; background: #e5e0da; border-radius: 1.6cqw; font-size: 5.4cqw; font-weight: 300; line-height: 1; letter-spacing: -.07em; }
  .svc__tag { align-self: flex-start; margin-top: 2cqw; padding: .14em .42em .18em; background: #2b2b2a; color: #fff; border-radius: 1.4cqw; font-size: 4.9cqw; font-weight: 300; line-height: 1; letter-spacing: -.06em; }
  .svc__logo { position: absolute; right: 15cqw; bottom: 11cqw; width: 14cqw; height: auto; }

  /* Lista larga (Estructura tu Expansión): arranca más arriba y letra un poco menor */
  .svc__in:has(.svc__list--largo) { padding-top: 22cqw; }
  .svc__in:has(.svc__list--largo) .svc__t { margin-left: 2.7cqw; }
  .svc__list--largo { margin: 6.7cqw 6cqw 0 4.9cqw; gap: 3.9cqw; }
  .svc__list--largo li { font-size: 4.9cqw; }
  .svc__in:has(.svc__list--largo) .svc__frase { margin-left: 2.7cqw; }

  /* Tarjetas centradas (Campaña Digital, Experiencia Galería 9) */
  .svc--centro .svc__in { padding: 18cqw 10cqw 0; justify-content: center; align-items: center; text-align: center; }
  .svc--centro .svc__t { margin: 0; }
  .svc--centro .svc__logo { position: static; margin-top: 9cqw; }
  .svc--centro .svc__frase { align-self: center; margin-top: 6cqw; }
  .svc__intro { align-self: flex-start; margin: 4cqw 0 .6cqw 1.5cqw; font-size: 4.9cqw; font-weight: 300; line-height: 1; letter-spacing: -.07em; }
  .svc--centro .svc__list { align-self: center; margin: 0 0 0 4cqw; gap: 2cqw; text-align: left; }
  .svc--centro .svc__list li { font-size: 4.9cqw; font-weight: 400; }
  .svc__checks { list-style: none; margin: 6cqw 0 0; padding: 0; display: flex; flex-direction: column; gap: 2.5cqw; text-align: left; }
  .svc__checks li { display: flex; align-items: center; gap: 2.4cqw; font-size: 7.3cqw; font-weight: 300; line-height: 1; letter-spacing: -.07em; }
  .svc__checks svg { flex: none; width: 8.6cqw; height: 8.6cqw; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .svc__tag--meta { align-self: center; margin-top: 8cqw; padding: .1em .45em .14em; border-radius: 2.2cqw; font-size: 8.4cqw; font-weight: 100; letter-spacing: -.05em; }

  @media (max-width: 1100px) { .ag__cards { grid-template-columns: repeat(2, 1fr); max-width: 720px; } }
  @media (max-width: 600px) { .ag__cards { grid-template-columns: 1fr; max-width: 360px; margin-inline: auto; } }
</style>
