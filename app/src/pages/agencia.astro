---
// 05 · Agencia (v4): servicio "Expresa tu talento + agencia". Encuesta de UNA
// opción entre los 4 servicios de "¿cómo ser parte de Galería 9?" (PDF del
// cliente) + datos de contacto → Leads, Interes = Agencia, Prioridades = la
// tarjeta elegida. Es la tercera puerta del home (Expansión).
// Tarjetas con el estilo del sitio, alto según su contenido; la 3ª columna apila
// Campaña Digital sobre Experiencia Galería 9.
import Base from '../layouts/Base.astro';

const C = { arena: '#e4dfd8', oro: '#dad1bd', gris: '#d3d0ce' };
const servicios = [
  {
    v: 'Visibilidad de tu Talento', k: 'Identidad visual', bg: C.arena,
    items: ['exploración de memorias del inconsciente', 'definición de paletas de colores', 'selección de tipografías', 'renders y visualización de tu producto', 'propuesta de identidad visual para tu talento'],
    frase: 'haz visible lo que te hace único', pie: 'duración: 1 semana',
  },
  {
    v: 'Estructura tu Expansión', k: 'Dirección, estrategia y estructura', bg: C.oro,
    items: ['4 de memorias del inconsciente', 'identificación de talentos, fortalezas y potencial', 'definición de visión y objetivos de expansión', 'identificación de oportunidades de crecimiento', 'diseño de estrategias y próximos pasos', 'mapa de expansión digital y físico', 'ruta de acción personalizada para tu negocio'],
    frase: 'un mapa para desarrollar tu negocio', pie: 'proyecto de 2 semanas',
  },
  {
    v: 'Campaña Digital', k: 'Marketing dirigido', bg: C.gris,
    items: ['una visión', 'un análisis', 'visibilidad'], pie: '1 meta',
  },
  {
    v: 'Experiencia Galería 9', k: 'Creación de comunidad', bg: C.arena,
    items: ['celebración personal', 'colaboraciones', 'tu producto', 'tus clientes', 'tu empresa'],
    frase: 'tu talento es una experiencia',
  },
];
// Columnas: 1 · 2 · (3 sobre 4)
const columnas = [[servicios[0]], [servicios[1]], [servicios[2], servicios[3]]];
---
<Base title="Expresa tu talento + agencia — Galería 9" description="Elige lo que buscas para tu marca: identidad visual, estructura de expansión, campaña digital o una experiencia en Galería 9.">
  <section class="section">
    <div class="wrap">
      <header class="mhead reveal">
        <span class="eyebrow">Expansión · Comunicación y estrategias</span>
        <h1 class="h2" style="margin-top:1rem">Expresa tu talento<br/>+ agencia.</h1>
      </header>

      <form id="f" class="mform ag__form" novalidate>
        <fieldset class="opt-group ag__busca reveal">
          <legend class="ag__q">¿Qué estás buscando?</legend>
          <div class="ag__cards">
            {columnas.map((col, ci) => (
              <div class={`ag__col${col.length > 1 ? ' ag__col--stack' : ''}`}>
                {col.map((s) => (
                  <label class="svc" style={`--bg:${s.bg}`}>
                    <input type="radio" name="busca" value={s.v} />
                    <span class="svc__top">
                      <span class="svc__k">{s.k}</span>
                      <span class="svc__check" aria-hidden="true"></span>
                    </span>
                    <span class="svc__t">{s.v}</span>
                    <ul class="svc__list">
                      {s.items.map((i) => (
                        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.8 12.3l2.8 2.8 5.6-6" /></svg>{i}</li>
                      ))}
                    </ul>
                    {(s.frase || s.pie) && (
                      <span class="svc__pie">
                        {s.frase && <span class="svc__frase">{s.frase}</span>}
                        {s.pie && <span class="svc__tag">{s.pie}</span>}
                      </span>
                    )}
                  </label>
                ))}
              </div>
            ))}
          </div>
        </fieldset>

        <div class="mform-two ag__datos reveal">
          <label class="mfield"><span>Nombre</span><input type="text" name="nombre" placeholder="Tu nombre" required /></label>
          <label class="mfield"><span>Celular / WhatsApp</span><input type="tel" name="telefono" placeholder="33 0000 0000" required /></label>
          <label class="mfield mfield--wide"><span>Correo electrónico</span><input type="email" name="correo" placeholder="tu@correo.com" required /></label>
          <label class="mfield mfield--wide"><span>Giro de negocio o talento</span><input type="text" name="giro" placeholder="Ej. Joyería artesanal, coaching, repostería…" required /></label>
          <label class="mfield mfield--wide"><span>Link de Instagram</span><input type="text" name="instagram" placeholder="instagram.com/tumarca" required /></label>
        </div>

        <div><button type="submit" class="btn">Enviar</button></div>
      </form>

      <div class="mdone" id="done" hidden>
        <div class="mdone__mark">✓</div>
        <h2 class="h2">¡Recibimos tus datos!</h2>
        <p class="lead">Te contactamos muy pronto para platicar de tu marca.</p>
        <div class="mdone__actions">
          <a href="/" class="btn btn--ghost">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initLeadForm, lineas, grupoObligatorio } from '../scripts/leadForm.js';
    const form = document.getElementById('f');
    const elegida = grupoObligatorio(form, 'busca');

    initLeadForm({
      validate: () => elegida(),
      build: (g) => ({
        interes: 'Agencia',
        detalle: lineas([
          ['Busca', g('busca')],
          ['Giro / talento', g('giro')],
          ['Instagram', g('instagram')],
        ]),
        extra: { Prioridades: [g('busca')] },
      }),
    });
  </script>
</Base>

<style>
  .ag__form { max-width: none; gap: clamp(2rem, 4vw, 2.8rem); }
  .ag__datos { max-width: 640px; }
  .ag__q { font-size: clamp(1.5rem, 2.4vw, 1.9rem); font-weight: 300; letter-spacing: -.01em; color: var(--ink); margin-bottom: 1.4rem; }

  /* Tarjetas con el estilo del sitio (colores de las pastillas, esquinas redondas).
     Cada una mide lo que pide su contenido. Se elige UNA. */
  .ag__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.9rem, 1.6vw, 1.3rem); align-items: start; max-width: 1080px; }
  .ag__col { display: grid; gap: clamp(.9rem, 1.6vw, 1.3rem); }
  .svc {
    position: relative; display: flex; flex-direction: column; gap: .9rem;
    padding: 1.5rem 1.5rem 1.6rem; background: var(--bg); color: var(--ink);
    border-radius: clamp(20px, 2.4vw, 28px); cursor: pointer;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .svc:hover { transform: translateY(-4px); box-shadow: 0 20px 34px -26px rgba(43, 43, 42, .5); }
  .svc input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .svc:has(input:checked) { box-shadow: 0 0 0 2px var(--ink); }
  .svc:has(input:focus-visible) { outline: 2px solid var(--gold); outline-offset: 3px; }
  .opt-group.invalid .svc { box-shadow: 0 0 0 2px #b4523f; }

  .svc__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .svc__k { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-ink); line-height: 1.4; }
  .svc__check {
    flex: none; width: 22px; height: 22px; border-radius: 50%;
    border: 1.5px solid var(--ink-45); background: rgba(255, 255, 255, .5);
    display: grid; place-items: center; transition: background .2s, border-color .2s;
  }
  .svc:has(input:checked) .svc__check { background: var(--ink); border-color: var(--ink); }
  .svc:has(input:checked) .svc__check::after { content: ''; width: 8px; height: 4px; border: 2px solid #fff; border-top: 0; border-right: 0; transform: rotate(-45deg) translate(1px, -1px); }

  .svc__t { font-size: clamp(1.3rem, 1.8vw, 1.55rem); font-weight: 500; line-height: 1.1; letter-spacing: -.02em; }
  .svc__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .svc__list li { display: flex; align-items: flex-start; gap: .6rem; font-size: .93rem; line-height: 1.35; color: var(--ink-70); }
  .svc__list svg { flex: none; width: 17px; height: 17px; margin-top: .12em; fill: none; stroke: var(--gold-ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .svc__pie { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .3rem; }
  .svc__frase { font-size: .8rem; background: rgba(255, 255, 255, .6); border-radius: 100px; padding: .45em .95em; }
  .svc__tag { font-size: .8rem; background: var(--ink); color: var(--paper); border-radius: 100px; padding: .45em .95em; }

  /* Tablet: 1 y 2 lado a lado, la columna apilada abajo con sus dos tarjetas en fila */
  @media (max-width: 960px) {
    .ag__cards { grid-template-columns: repeat(2, 1fr); }
    .ag__col--stack { grid-column: 1 / -1; grid-template-columns: repeat(2, 1fr); align-items: start; }
  }
  @media (max-width: 600px) {
    .ag__cards, .ag__col--stack { grid-template-columns: 1fr; }
  }
</style>
