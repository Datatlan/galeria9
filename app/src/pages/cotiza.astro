---
// 01 · Eventos (v2): solicitud de evento SIN cotización ni tarifas. Cae en
// Leads (Interes = Evento); el equipo confirma disponibilidad y aparta el
// espacio a mano. La URL /cotiza se conserva para no romper links.
import Base from '../layouts/Base.astro';

const espacios = [
  { n: 'Terraza', d: 'Patio verde en planta baja. Íntimo y cálido, ideal para reuniones y talleres.' },
  { n: 'Roof', d: 'Azotea con zona techada y cielo abierto. Para activaciones y celebraciones.' },
];
---
<Base title="Solicita tu evento — Galería 9" description="Cuéntanos de tu evento en Galería 9 y te confirmamos disponibilidad por WhatsApp.">
  <section class="section">
    <div class="wrap">
      <header class="mhead reveal">
        <span class="eyebrow">Espacios y eventos</span>
        <h1 class="h2" style="margin-top:1rem">Solicita tu evento.</h1>
        <p class="lead">Cuéntanos de tu evento y te confirmamos disponibilidad por WhatsApp.</p>
      </header>

      <aside class="promo reveal">
        <span class="promo__t">Promoción especial para tus eventos</span>
        <p>Renta el espacio por 3 horas a $250 MXN por persona, con un mínimo de 10 personas. Incluye mesas, sillas y mantel, además de proyector.</p>
      </aside>

      <form id="f" class="mform reveal" novalidate>
        <div class="mform-two">
          <label class="mfield"><span>Nombre de contacto</span><input type="text" name="nombre" placeholder="Tu nombre" required /></label>
          <label class="mfield"><span>Celular / WhatsApp</span><input type="tel" name="telefono" placeholder="33 0000 0000" required /></label>
          <label class="mfield mfield--wide"><span>Correo electrónico</span><input type="email" name="correo" placeholder="tu@correo.com" required /></label>
          <label class="mfield mfield--wide"><span>Tipo o nombre del evento</span><input type="text" name="tipo" placeholder="Ej. Taller de cerámica, cumpleaños, lanzamiento…" required /></label>

          <fieldset class="mfield mfield--wide opt-group">
            <legend>Espacio <span class="muted">(puedes elegir ambos)</span></legend>
            <div class="opt-cards">
              {espacios.map((e) => (
                <label class="opt-card">
                  <input type="checkbox" name="espacio" value={e.n} />
                  <span class="opt-card__check" aria-hidden="true"></span>
                  <span class="opt-card__sub">{e.n}</span>
                  <span class="opt-card__d">{e.d}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="mfield"><span>Fecha <span class="muted">(lunes a sábado)</span></span><input type="date" name="fecha" required /></label>
          <label class="mfield"><span>Número estimado de personas</span><input type="number" name="personas" min="1" placeholder="Ej. 30" required /></label>
          <label class="mfield mfield--wide"><span>Hora de inicio y término, o duración estimada</span><input type="text" name="horario" placeholder="Ej. 6:00 pm a 10:00 pm · o · 3 horas" required /></label>
          <label class="mfield mfield--wide"><span>Comentarios o necesidades adicionales <span class="muted">(opcional)</span></span><textarea name="comentarios" rows="4" placeholder="Montaje, mobiliario, audio, catering…"></textarea></label>
        </div>
        <div><button type="submit" class="btn">Enviar solicitud</button></div>
      </form>

      <div class="mdone" id="done" hidden>
        <div class="mdone__mark">✓</div>
        <h2 class="h2">¡Recibimos tu solicitud!</h2>
        <p class="lead">Revisamos disponibilidad y te contactamos muy pronto por WhatsApp.</p>
        <div class="mdone__actions">
          <button type="button" class="btn" data-cal-link="galeria-9-raembd/visita-galeria-9" data-cal-namespace="visita" data-cal-config='{"layout":"month_view","theme":"light"}'>Conoce el espacio · Agenda una visita</button>
          <a href="/" class="btn btn--ghost">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/calPopup.js';
    import { initLeadForm, bloquearDomingos, grupoObligatorio, lineas, fechaLarga } from '../scripts/leadForm.js';
    const form = document.getElementById('f');
    bloquearDomingos(form.elements['fecha']);
    const espacioOk = grupoObligatorio(form, 'espacio');
    initLeadForm({
      validate: () => espacioOk(),
      build: (g, fd) => ({
        interes: 'Evento',
        mensaje: g('comentarios'),
        detalle: lineas([
          ['Evento', g('tipo')],
          ['Espacio', fd.getAll('espacio').join(' + ')],
          ['Fecha', fechaLarga(g('fecha'))],
          ['Horario', g('horario')],
          ['Personas', g('personas')],
        ]),
      }),
    });
  </script>
</Base>
