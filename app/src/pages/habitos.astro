---
import Base from '../layouts/Base.astro';
import Cabinas from '../components/Cabinas.astro';

// Íconos de "website design.pdf" (renderizados del PDF: public/habitos/h1–h9.png).
// Se leen como una suma: sincronía + mente + … + invierte en ti = Líder en Expansión.
const nombres = ['sincronía', 'mente', 'respiración', 'sonido', 'cuerpo', 'movimiento', 'nutrición', 'belleza', 'invierte en ti'];
const iconos = nombres.map((n, i) => ({ n, src: `/habitos/h${i + 1}.png` }));
// Planes de hábitos (paquetes de los servicios residentes). Mientras no haya cobro en
// línea (Stripe), el botón abre WhatsApp de Galería 9 con el plan en el mensaje.
const WA = '523318030563';
const planes = [
  { n: 'Express', precio: '$3,999 MXN', citas: '3 citas · 60 min cada una', items: [['inconsciente', 1], ['mente', 2], ['respiración y sonido', 3], ['masaje relajante', 5]] },
  { n: 'Reset', precio: '$2,999 MXN', citas: '2 citas · 60 min cada una', items: [['inconsciente', 1], ['mente', 2], ['respiración y sonido', 3]] },
];
const waPlan = (p) => `https://wa.me/${WA}?text=${encodeURIComponent(`Hola, me interesa el plan ${p.n} de Nuevos hábitos (${p.precio}).`)}`;
// Alta a la comunidad: mismo endpoint del newsletter (Worker galeria9-mkt → Kit + Airtable)
const SUBSCRIBE_URL = 'https://galeria9-mkt.datatlan.workers.dev/subscribe';
---
<Base title="Nuevos hábitos — Galería 9" description="Consciencia y transformación en Galería 9: únete a la comunidad y conoce los servicios residentes de bienestar.">
  <section class="hab">
    <div class="wrap hab__inner">
      <div class="hab__main">
        <h1 class="hab__title reveal">Nuevos hábitos</h1>

        <div class="hab__icons reveal" role="img" aria-label={`${nombres.join(' + ')} = Líder en Expansión`}>
          {iconos.map((ic, i) => (
            <>
              {i > 0 && <span class={`hab__op${i % 3 === 0 ? ' hab__op--fila' : ''}`} style={`--i:${i}`} aria-hidden="true">+</span>}
              <span class="hab__term" style={`--i:${i}`} aria-hidden="true">
                <img src={ic.src} alt="" width="120" height="120" />
                <span class="hab__name">{ic.n}</span>
              </span>
            </>
          ))}
          <span class="hab__total" aria-hidden="true">
            <span class="hab__op hab__op--eq" style="--i:9">=</span>
            <span class="hab__res">Líder en Expansión</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <Cabinas compact />

  <section class="planes">
    <div class="wrap">
      <div class="planes__head reveal">
        <span class="eyebrow">Planes de hábitos</span>
        <p class="muted">Combina los servicios residentes en un plan a tu ritmo.</p>
      </div>
      <div class="planes__grid">
        {planes.map((p, i) => (
          <article class="plan reveal" style={`transition-delay:${i * 90}ms`}>
            <header class="plan__head">
              <h2 class="plan__n">{p.n}</h2>
              <span class="plan__precio">{p.precio}</span>
            </header>
            <ul class="plan__items">
              {p.items.map(([t, ic]) => (
                <li><img src={`/habitos/h${ic}.png`} alt="" width="120" height="120" loading="lazy" /><span>{t}</span></li>
              ))}
            </ul>
            <footer class="plan__pie">
              <span class="plan__citas">{p.citas}</span>
              <a class="btn plan__btn" href={waPlan(p)} target="_blank" rel="noopener">Lo quiero</a>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="hab hab--form">
    <div class="wrap hab__inner">
      <div class="hab__main">
        <p class="hab__intro reveal">¿Buscas un cambio? ¿un nuevo estilo de vida?<br/>¿consciencia y transformación? <span>¡Bienvenid@ a la comunidad!</span></p>

        <form class="hab__form reveal" id="habForm" novalidate data-url={SUBSCRIBE_URL}>
          <label class="hab__field"><span>Nombre completo</span><input name="nombre" autocomplete="name" required maxlength="60" /></label>
          <label class="hab__field"><span>Celular</span><input name="celular" type="tel" autocomplete="tel" inputmode="tel" required maxlength="20" /></label>
          <label class="hab__field"><span>Correo</span><input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
          <input class="hab__hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="hab__btn" type="submit">Digo <em>sí</em> a mi expansión</button>
          <p class="hab__msg" id="habMsg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('habForm') as HTMLFormElement | null;
  const msg = document.getElementById('habMsg')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const nombre = d.nombre.trim(), celular = d.celular.trim(), email = d.email.trim();
    msg.className = 'hab__msg';
    if (!nombre || !celular || !email) { msg.textContent = 'Completa tu nombre, celular y correo.'; msg.classList.add('is-err'); return; }
    if (!/^\S+@\S+\.\S+$/.test(email)) { msg.textContent = 'Revisa tu correo.'; msg.classList.add('is-err'); return; }
    if (celular.replace(/\D/g, '').length < 10) { msg.textContent = 'Revisa tu celular (10 dígitos).'; msg.classList.add('is-err'); return; }
    const btn = form.querySelector('button')!;
    btn.disabled = true; msg.textContent = 'Enviando…';
    try {
      const res = await fetch(form.dataset.url!, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, celular, email, origen: 'nuevos-habitos', website: d.website }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.add('is-done');
      msg.textContent = '¡Listo! Ya eres parte de la comunidad. Revisa tu correo.';
    } catch {
      btn.disabled = false;
      msg.textContent = 'No se pudo enviar. Intenta de nuevo en un momento.'; msg.classList.add('is-err');
    }
  });
</script>

<style>
  .hab { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem); }
  .hab--form { padding-block: 0 clamp(3.5rem, 8vw, 6rem); }
  .hab--form .hab__intro { margin-top: 0; }
  .hab__inner { display: grid; grid-template-columns: 1fr; }
  .hab__title { font-size: clamp(2.6rem, 6.2vw, 5rem); font-weight: 100; line-height: 1; letter-spacing: -.02em; text-transform: uppercase; }

  /* Fórmula: ícono + nombre, sumados, = Líder en Expansión. Al entrar en pantalla los
     términos aparecen uno por uno y el resultado al final. Hover: cada ícono sube ("olita"). */
  .hab__icons { display: flex; flex-wrap: wrap; align-items: flex-start; gap: clamp(.9rem, 1.5vw, 1.2rem) clamp(.3rem, .5vw, .4rem); margin-top: clamp(1.4rem, 2.6vw, 2.2rem); }
  .hab__term { display: flex; flex-direction: column; align-items: center; gap: .45rem; width: clamp(58px, 4.8vw, 64px); }
  .hab__total { display: flex; align-items: flex-start; white-space: nowrap; }
  .hab__icons img { width: clamp(46px, 4.6vw, 60px); height: auto; transition: transform .45s cubic-bezier(.34, 1.56, .64, 1); }
  .hab__term:hover img { transform: translateY(-10px); transition-duration: .2s; }
  .hab__name { font-size: .72rem; letter-spacing: .02em; line-height: 1.15; text-align: center; color: var(--ink-70); }
  .hab__op { align-self: flex-start; height: clamp(46px, 4.6vw, 60px); display: grid; place-items: center; font-size: 1.1rem; font-weight: 200; color: var(--gold-ink); }
  .hab__op--eq { margin-inline: .3rem; font-size: 1.5rem; }
  .hab__res {
    align-self: flex-start; display: inline-flex; align-items: center; height: clamp(46px, 4.6vw, 60px);
    padding: 0 1.1em; border-radius: 100px; background: var(--ink); color: var(--paper);
    font-size: clamp(.9rem, 1.15vw, 1rem); font-weight: 400; letter-spacing: .01em; white-space: nowrap;
  }
  .hab__term, .hab__op, .hab__res { opacity: 0; transform: translateY(8px); }
  .hab__icons.in .hab__term, .hab__icons.in .hab__op { animation: hab-sum .5s var(--ease) forwards; animation-delay: calc(var(--i) * 110ms); }
  .hab__icons.in .hab__res { animation: hab-res .7s var(--ease) forwards; animation-delay: calc(10 * 110ms + 150ms); }
  @keyframes hab-sum { to { opacity: 1; transform: none; } }
  @keyframes hab-res { 0% { opacity: 0; transform: scale(.85); } 70% { opacity: 1; transform: scale(1.04); } 100% { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hab__term, .hab__op, .hab__res { opacity: 1; transform: none; animation: none !important; } }

  /* Celular: 3 renglones de 3 con "+" entre íconos; entre renglones un "+" centrado
     (los que van antes del 4º y del 7º término) y al final "= Líder en Expansión". */
  @media (max-width: 640px) {
    .hab__icons { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; justify-items: center; gap: .5rem .4rem; }
    .hab__term { width: auto; }
    .hab__op--fila { grid-column: 1 / -1; height: auto; line-height: 1; }
    .hab__total { grid-column: 1 / -1; justify-self: center; align-items: center; margin-top: .6rem; }
    .hab__op--eq { height: auto; }
  }

  /* Planes de hábitos: tarjetas hueso con ícono por servicio, precio arriba a la derecha */
  .planes { padding-block: 0 clamp(3rem, 6vw, 4.5rem); }
  .planes__head { display: flex; align-items: baseline; gap: .6rem 1.6rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
  .planes__head p { margin: 0; font-size: .95rem; }
  .planes__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.6rem); max-width: 900px; align-items: stretch; }
  .plan { display: flex; flex-direction: column; gap: 1.4rem; padding: clamp(1.6rem, 3vw, 2.4rem); background: #e3dfd9; border-radius: clamp(20px, 2.4vw, 28px); }
  .plan__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .plan__n { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 700; letter-spacing: -.04em; line-height: 1; }
  .plan__precio { font-size: clamp(1.05rem, 1.6vw, 1.3rem); font-weight: 300; letter-spacing: -.02em; white-space: nowrap; }
  .plan__items { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .plan__items li { display: flex; align-items: center; gap: 1rem; font-size: clamp(1rem, 1.4vw, 1.15rem); letter-spacing: -.02em; }
  .plan__items img { width: 48px; height: auto; flex: none; }
  .plan__pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: auto; padding-top: .4rem; }
  .plan__citas { font-size: .95rem; color: var(--ink-70); }
  @media (max-width: 700px) { .planes__grid { grid-template-columns: 1fr; } }

  .hab__intro { margin-top: clamp(1.8rem, 3vw, 2.6rem); font-size: clamp(1.1rem, 1.7vw, 1.45rem); font-weight: 400; line-height: 1.55; color: var(--ink); }
  .hab__intro span { white-space: nowrap; }

  .hab__form { display: grid; gap: 1.1rem; max-width: 460px; margin-top: clamp(1.8rem, 3vw, 2.6rem); }
  .hab__field { display: flex; flex-direction: column; gap: .45rem; }
  .hab__field span { font-size: .82rem; letter-spacing: .04em; color: var(--ink-70); }
  .hab__field input {
    font: inherit; font-size: 1rem; color: var(--ink); background: var(--white);
    padding: .9em 1em; border: 1px solid var(--ink-12); border-radius: var(--radius);
  }
  .hab__field input:focus { outline: none; border-color: var(--ink); }
  .hab__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .hab__btn {
    justify-self: start; margin-top: .6rem; font: inherit; font-size: clamp(1.05rem, 1.5vw, 1.3rem); font-weight: 400;
    color: var(--paper); background: var(--ink); border: 1px solid var(--ink); padding: .95em 1.5em; cursor: pointer;
    transition: background .3s var(--ease), color .3s var(--ease);
  }
  .hab__btn em { font-weight: 700; }
  .hab__btn:hover { background: transparent; color: var(--ink); }
  .hab__btn:disabled { opacity: .55; cursor: default; }
  .hab__msg { min-height: 1.4em; font-size: .92rem; color: var(--gold-ink); }
  .hab__msg.is-err { color: #b4523f; }
  .hab__form.is-done .hab__field, .hab__form.is-done .hab__btn { display: none; }
  .hab__form.is-done .hab__msg { font-size: 1.15rem; color: var(--ink); }


  @media (prefers-reduced-motion: reduce) { .hab__icons img { transition: none; } .hab__icons img:hover { transform: none; } }
  @media (max-width: 760px) {
    .hab__inner { grid-template-columns: 1fr; }
    .hab__intro br { display: none; }
    .hab__btn { justify-self: stretch; }
  }
</style>
