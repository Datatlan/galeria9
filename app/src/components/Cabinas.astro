---
// Servicios residentes de bienestar (piezas del cliente, nov-2026). En el orden de la
// fórmula de /habitos: inconsciente · mente · respiración · sonido · cuerpo · belleza.
// Título: la primera parte en itálica (it) y el resto normal (t). Ícono = public/habitos/hN.png.
// Reemplaza a las marcas residentes anteriores (Elsonidodefer, Carolina, Manoela, Jar…).
const servicios = [
  { it: 'Investigación del', t: 'Inconsciente', ic: 1, d: 'investigación del origen de tus acciones que repites de forma inconsciente.', wa: '33 1803 0563' },
  { it: 'Entrena', t: 'tu Palabra', ic: 2, d: 'entrena tu mente y tu palabra para avanzar con claridad.', dur: '1 hora', wa: '33 1803 0563' },
  { it: 'Sesiones de', t: 'Respiración', ic: 3, d: 'breathwork y programa aprende a respirar.', wa: '33 3954 0777' },
  { it: 'Experiencia de', t: 'Sonido', ic: 4, d: 'sound healing en grupo, pareja y privadas 1:1.', wa: '33 3954 0777' },
  { it: 'El arte de', t: 'Volver a ti', ic: 5, intro: 'masajes terapéuticos', items: ['relajante', 'bruxismo', 'deportivo', 'drenaje linfático', 'estrés y ansiedad'], wa: '33 3956 4990' },
  { it: 'Diseña', t: 'tu Mirada', ic: 8, items: ['lifting de pestañas', 'depilación', 'faciales'], wa: '33 3393 9295' },
];
const waLink = (n) => `https://wa.me/52${n.replace(/\D/g, '')}`;
---
<section class="section cabinas cabinas--compact" id="cabinas">
  <div class="wrap">
    <div class="cab__head reveal">
      <span class="eyebrow">Servicios residentes</span>
      <p class="muted">Cada uno con su especialidad. Escríbeles directo para agendar tu cita.</p>
    </div>

    <div class="cabgrid">
      {servicios.map((s, i) => (
        <article class="cab reveal" style={`transition-delay:${(i % 3) * 70}ms`}>
          <img class="cab__ic" src={`/habitos/h${s.ic}.png`} alt="" width="120" height="120" loading="lazy" />
          <h3 class="cab__name"><em>{s.it}</em> {s.t}</h3>
          {s.d && <p class="cab__d">{s.d}</p>}
          {s.intro && <p class="cab__intro">{s.intro}</p>}
          {s.items && <ul class="cab__list">{s.items.map((x) => <li>{x}</li>)}</ul>}
          <div class="cab__pie">
            {s.dur && <span class="cab__dur">{s.dur}</span>}
            <a class="cab__wa" href={waLink(s.wa)} target="_blank" rel="noopener">+52 {s.wa}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cabinas--compact { padding-block: 1rem clamp(3rem, 6vw, 4.5rem); }
  .cab__head { display: flex; align-items: baseline; gap: .6rem 1.6rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
  .cab__head p { margin: 0; font-size: .95rem; }
  .cabgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.4rem); }

  /* Tarjeta hueso como las piezas del cliente: ícono, título itálica + normal, texto, teléfono */
  .cab {
    display: flex; flex-direction: column; gap: .8rem;
    padding: clamp(1.5rem, 2.6vw, 2rem); min-height: 300px;
    background: #e3dfd9; border-radius: clamp(20px, 2.4vw, 28px); color: var(--ink);
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .cab:hover { transform: translateY(-4px); box-shadow: 0 20px 34px -26px rgba(43, 43, 42, .5); }
  .cab__ic { width: 52px; height: auto; margin-bottom: .6rem; }
  .cab__name { font-size: clamp(1.45rem, 2vw, 1.75rem); font-weight: 400; line-height: 1.05; letter-spacing: -.035em; }
  .cab__name em { font-style: italic; }
  .cab__d { font-size: .98rem; line-height: 1.35; letter-spacing: -.01em; color: var(--ink); }
  .cab__intro { font-size: .98rem; font-style: italic; letter-spacing: -.01em; margin-bottom: -.3rem; }
  .cab__list { margin: 0; padding-left: 1.1rem; display: grid; gap: .2rem; font-size: .98rem; line-height: 1.3; }
  .cab__pie { margin-top: auto; padding-top: .6rem; display: flex; flex-direction: column; align-items: flex-end; gap: .2rem; text-align: right; }
  .cab__dur { font-size: .95rem; }
  .cab__wa { font-size: 1.05rem; letter-spacing: -.02em; transition: color .3s var(--ease); }
  .cab__wa:hover { color: var(--gold-ink); text-decoration: underline; }

  @media (max-width: 980px) { .cabgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .cabgrid { grid-template-columns: 1fr; } .cab { min-height: 0; } }
</style>
