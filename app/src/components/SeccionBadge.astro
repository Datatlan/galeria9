---
// Mini tarjeta de sección (versión chica de las tarjetas del home), arriba a la
// derecha de cada página de sección. Lleva de regreso a las tarjetas del home.
const { t, sub, ic, bg } = Astro.props; // ic: corazon | pulso | mente
---
<a class="sbadge reveal" href="/#puertas" style={`--bg:${bg}`} aria-label={`${t} · ${sub}`}>
  <strong>{t}</strong>
  <span>{sub}</span>
  <img src={`/home/ic-${ic}.svg`} alt="" />
</a>

<style>
  .sbadge {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: .15rem;
    width: 150px; padding: 1.1rem .8rem 1.3rem; border-radius: 26px; background: var(--bg); color: var(--ink);
    transition: transform .35s var(--ease);
  }
  .sbadge:hover { transform: translateY(-4px); }
  .sbadge strong { font-size: .78rem; font-weight: 700; text-transform: uppercase; }
  .sbadge span { font-size: .55rem; text-transform: uppercase; letter-spacing: .02em; }
  .sbadge img { width: 54px; height: 46px; object-fit: contain; margin-top: .9rem; }
  @media (max-width: 760px) { .sbadge { display: none; } }
</style>
