---
// Próximos eventos públicos + modal "Me interesa".
// Se usa embebido en el index (se oculta si no hay eventos) y como página
// completa en /eventos (standalone: siempre visible, con estado vacío).
const { standalone = false } = Astro.props;
---
<section class={`section agenda ${standalone ? 'agenda--page' : ''}`} id="agenda" hidden={!standalone} data-standalone={standalone ? '' : undefined}>
  <div class="wrap">
    <div class="two">
      <div class="reveal">
        <span class="eyebrow">{standalone ? 'Agenda' : 'Qué está pasando'}</span>
        {standalone
          ? <h1 class="h2" style="margin-top:1.2rem">Próximos<br/>eventos.</h1>
          : <h2 class="h2" style="margin-top:1.2rem">Próximos<br/>eventos.</h2>}
      </div>
      <div class="reveal">
        <p class="lead">Talleres, activaciones y encuentros abiertos en Galería 9. Aparta tu lugar.</p>
        {!standalone && <a href="/eventos" class="link-arrow agenda__all">Ver todos los eventos →</a>}
      </div>
    </div>
    <div class="grid-ev" id="agendaGrid"></div>
    {standalone && (
      <p class="muted agenda__empty" id="agendaEmpty" hidden>
        Por ahora no hay eventos abiertos. Síguenos en Instagram para enterarte del próximo.
      </p>
    )}
  </div>
</section>

<!-- Modal "Me interesa" -->
<div class="ev-modal" id="evModal" hidden>
  <div class="ev-modal__box" role="dialog" aria-modal="true" aria-labelledby="evModalT">
    <button type="button" class="ev-modal__x" id="evModalX" aria-label="Cerrar">×</button>
    <span class="eyebrow" style="color:var(--gold)">Me interesa</span>
    <h3 class="h3" id="evModalT" style="margin:.6rem 0 .3rem">Evento</h3>
    <p class="muted" id="evModalD" style="margin-bottom:1.4rem"></p>
    <form id="evForm" novalidate>
      <label class="cfield"><span>Tu nombre</span><input type="text" name="nombre" placeholder="Nombre" required /></label>
      <label class="cfield"><span>WhatsApp</span><input type="tel" name="telefono" placeholder="33 0000 0000" required /></label>
      <label class="cfield"><span>Correo <i>(opcional)</i></span><input type="email" name="correo" placeholder="tu@correo.com" /></label>
      <button type="submit" class="btn" style="margin-top:.6rem;width:100%">Quiero asistir</button>
    </form>
    <div class="ev-modal__done" id="evDone" hidden>
      <div class="ev-modal__mark">✓</div>
      <p class="lead">¡Listo! Te avisamos los detalles por WhatsApp.</p>
    </div>
  </div>
</div>

<script>
  import { T, crear, leerEventosPublicos } from '../config.js';

  const escEv = (s) => String(s ?? '').replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
  (async () => {
    const section = document.getElementById('agenda');
    const standalone = section.hasAttribute('data-standalone');
    let eventos = [];
    try { eventos = await leerEventosPublicos(); } catch { eventos = []; }
    if (!eventos.length) {
      if (standalone) document.getElementById('agendaEmpty').hidden = false;
      return; // embebido: la sección se queda oculta
    }

    const fmtEv = (ini, fin) => {
      if (!ini) return '';
      const a = new Date(ini);
      const dia = a.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });
      const hIni = a.toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' });
      const hFin = fin ? new Date(fin).toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' }) : '';
      return `${dia} · ${hIni}${hFin ? ` – ${hFin}` : ''}`;
    };

    const grid = document.getElementById('agendaGrid');
    grid.innerHTML = eventos.map((e) => `
      <article class="ev-card reveal in">
        ${e.imagen ? `<figure class="ev-card__media"><img src="${escEv(e.imagen)}" alt="${escEv(e.titulo)}" loading="lazy" /></figure>` : ''}
        <div class="ev-card__body">
          <span class="ev-card__date">${escEv(fmtEv(e.inicio, e.fin))}</span>
          <h3 class="h3">${escEv(e.titulo)}</h3>
          ${e.espacios.length ? `<span class="ev-card__place">${escEv(e.espacios.join(' · '))}</span>` : ''}
          ${e.descripcion ? `<p class="muted">${escEv(e.descripcion)}</p>` : ''}
          <button type="button" class="btn ev-card__btn"
            data-id="${escEv(e.id)}" data-t="${escEv(e.titulo)}" data-d="${escEv(fmtEv(e.inicio, e.fin))}">Me interesa</button>
        </div>
      </article>`).join('');
    section.hidden = false;

    // Modal "Me interesa"
    const modal = document.getElementById('evModal');
    const evForm = document.getElementById('evForm');
    const evDone = document.getElementById('evDone');
    let idSel = '';
    const abrir = (id, t, d) => {
      idSel = id;
      document.getElementById('evModalT').textContent = t;
      document.getElementById('evModalD').textContent = d;
      evForm.hidden = false; evDone.hidden = true; evForm.reset();
      modal.hidden = false; document.body.style.overflow = 'hidden';
    };
    const cerrar = () => { modal.hidden = true; document.body.style.overflow = ''; };
    grid.querySelectorAll('.ev-card__btn').forEach((b) =>
      b.addEventListener('click', () => abrir(b.dataset.id, b.dataset.t, b.dataset.d)));
    document.getElementById('evModalX').addEventListener('click', cerrar);
    modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });

    evForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(evForm);
      const g = (k) => (fd.get(k) || '').toString().trim();
      // Bloqueo explícito (no solo reportValidity): nombre y WhatsApp obligatorios.
      if (!g('nombre') || !g('telefono')) { evForm.reportValidity(); return; }
      const btn = evForm.querySelector('[type=submit]');
      btn.disabled = true; btn.textContent = 'Enviando…';
      try {
        await crear(T.interesados, {
          Nombre: g('nombre'),
          WhatsApp: g('telefono'),
          Correo: g('correo') || undefined,
          Evento: idSel ? [idSel] : undefined,
        });
        evForm.hidden = true; evDone.hidden = false;
      } catch (err) {
        btn.disabled = false; btn.textContent = 'Quiero asistir';
        alert('No pudimos registrarte. Intenta de nuevo.');
        console.error(err);
      }
    });
  })();
</script>

<style>
  /* Lo estático del componente (con scope). Las CARDS se inyectan por JS, así
     que sus estilos van en el bloque is:global de abajo. */
  .grid-ev { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.8rem; margin-top: 2.5rem; }
  .agenda__all { display: inline-flex; margin-top: 1.2rem; }
  .agenda--page { min-height: 60vh; }
  .agenda__empty { margin-top: 2.5rem; max-width: 46ch; }

  .ev-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 1.5rem; background: rgba(43,43,42,.55); backdrop-filter: blur(3px); }
  .ev-modal__box { position: relative; width: 100%; max-width: 420px; background: var(--paper); border-radius: var(--radius); padding: 2rem; box-shadow: 0 30px 80px -20px rgba(43,43,42,.5); }
  .ev-modal__x { position: absolute; top: .8rem; right: 1rem; background: none; border: 0; font-size: 1.6rem; line-height: 1; color: var(--ink-45); cursor: pointer; }
  .ev-modal__x:hover { color: var(--ink); }
  .ev-modal__done { text-align: center; padding: 1rem 0; }
  .ev-modal__mark { width: 48px; height: 48px; margin: 0 auto 1rem; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--paper); font-size: 1.3rem; }

  /* Campos del modal (fondo claro). */
  .cfield { display: flex; flex-direction: column; gap: .45rem; margin-bottom: 1rem; }
  .cfield > span { font-size: .78rem; letter-spacing: .06em; color: var(--ink-70, rgba(43,43,42,.7)); }
  .cfield i { font-style: normal; opacity: .6; }
  .cfield input {
    font-family: var(--sans); font-size: 1rem; color: var(--ink); background: var(--white);
    padding: .85em 1em; border: 1px solid var(--ink-12); border-radius: var(--radius);
    transition: border-color .3s var(--ease);
  }
  .cfield input::placeholder { color: var(--ink-45); }
  .cfield input:focus { outline: none; border-color: var(--ink); }
</style>

<style is:global>
  .ev-card {
    display: flex; flex-direction: column; background: var(--white);
    border: 1px solid var(--ink-12); border-radius: var(--radius); overflow: hidden;
    box-shadow: 0 1px 2px rgba(43,43,42,.04), 0 12px 30px -18px rgba(43,43,42,.25);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .ev-card:hover { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(43,43,42,.05), 0 22px 44px -20px rgba(43,43,42,.38); }
  .ev-card__media { margin: 0; aspect-ratio: 3/2; overflow: hidden; background: var(--sand); }
  .ev-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .ev-card:hover .ev-card__media img { transform: scale(1.04); }
  .ev-card__body { display: flex; flex-direction: column; gap: .55rem; padding: 1.5rem; flex: 1; }
  .ev-card__date { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-ink); font-weight: 600; line-height: 1.4; }
  .ev-card__body .h3 { margin: .15rem 0; }
  .ev-card__place { display: inline-block; font-size: .72rem; letter-spacing: .04em; color: var(--ink-45); padding: .15em .6em; border: 1px solid var(--ink-12); border-radius: 999px; align-self: flex-start; }
  .ev-card__body .muted { font-size: .88rem; line-height: 1.55; }
  /* margin-top:auto pega el botón al fondo: misma distancia al borde inferior
     sin importar si el título es de 1 o 2 líneas. */
  .ev-card__btn { margin-top: auto; align-self: flex-start; }
</style>
